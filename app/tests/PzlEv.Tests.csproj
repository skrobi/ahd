<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testy logiki PZL-EV. Projekt kompiluje pliki logiki aplikacji (src/) dla net10.0 – bez WPF:
    wszystko poza widokami, ViewModelami, powłoką, Shared/Utils/Ui, plikami wejścia modułów (*Module.cs)
    i modułem Diagnostyka. Użycie typu WPF w logice = błąd budowy testów (logika ma działać bez UI,
    docs/architektura.md, rozdz. 5.3). Testy działają także poza Windows.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PzlEv.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\**\*.cs"
             Exclude="..\src\obj\**;..\src\bin\**;..\src\**\Views\**;..\src\**\ViewModels\**;..\src\Shell\**;..\src\Shared\Utils\Ui\**;..\src\App.xaml.cs;..\src\Modules\*\*Module.cs;..\src\Modules\Diagnostics\**"
             LinkBase="App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migracje schematu (te same co w aplikacji) – testy magazynów SQL. -->
    <EmbeddedResource Include="..\..\sql\mssql\*.sql" LogicalName="PzlEv.Sql.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\sql\pzlprod\*.sql" LogicalName="PzlEv.PzlProd.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dane wzorcowe (app/testdata) w katalogu wyjściowym testów. -->
    <None Include="..\testdata\**\*" LinkBase="testdata" CopyToOutputDirectory="PreserveNewest" />
    <!-- Wzór konfiguracji aplikacji – test poprawności. -->
    <None Include="..\pzl-ev.json" Link="pzl-ev.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Te same wersje co w aplikacji (src/PzlEv.csproj). -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

</Project>
