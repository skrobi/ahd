<Window x:Class="PzlEv.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PZL-EV" Width="1360" Height="880" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" FontFamily="{StaticResource FBody}" FontSize="13"
        Foreground="{StaticResource Ink}">

    <!-- Powłoka: pasek środowiska, menu modułów i miejsce na ekran wybranego modułu. Bez treści modułów. -->
    <DockPanel>
        <!-- Pasek środowiska -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PZL-EV" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Pipeline EV · PZL Mielec" Margin="10,0,0,0"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Padding="0,0,0,2" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding WindowsUser}" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Konto Windows (AD) bieżącego użytkownika" />
                <Border DockPanel.Dock="Right" Background="{StaticResource WarnSoft}" CornerRadius="4" Padding="8,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Environment}" FontFamily="{StaticResource FMono}" FontSize="12"
                               Foreground="{StaticResource Warn}" FontWeight="Medium" />
                </Border>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menu modułów (z IModule.NavLabel / NavBadge) – zwijane do ikon („☰” u góry); nazwa w podpowiedzi -->
            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,1,0" Padding="10,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="210" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NavCollapsed}" Value="True">
                                <Setter Property="Width" Value="60" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource NavBtn}" HorizontalAlignment="Left" Margin="0,0,0,8"
                            Command="{Binding ToggleNav}" ToolTip="Zwiń / rozwiń menu" AutomationProperties.Name="Zwiń / rozwiń menu">
                        <TextBlock Text="&#xE700;" FontFamily="{StaticResource FIcon}" FontSize="16" />
                    </Button>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NavCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding Footer}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DatabaseText}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Nav}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavBtn}" HorizontalAlignment="Stretch" ToolTip="{Binding Label}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.Navigate, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontFamily="{StaticResource FIcon}" FontSize="16"
                                                   Width="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <Border DockPanel.Dock="Right">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource CountBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource FMono}" FontSize="11"
                                                       Foreground="{StaticResource Muted}" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Ekran wybranego modułu (IModule.CreateView) w układzie strony z Templates/Theme.xaml -->
            <ScrollViewer Grid.Column="1" Style="{StaticResource PageHost}">
                <ContentControl Content="{Binding CurrentView}" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
