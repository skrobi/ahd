<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PZL-EV – aplikacja (C#/.NET 10, WPF). Powstała z aplikacji testowej stosu (proof of concept):
    Cel: sprawdzić, czy przy założeniach docelowych (C#/.NET 10, WPF, wskazane
    pakiety NuGet) da się zbudować jeden self-contained single-file PZL-EV.exe,
    który uruchomi się z dysku sieciowego bez instalacji .NET i bez bazy danych.

    Aplikacja NIE łączy się z żadną bazą. Pakiety bazodanowe i Excela są tylko
    REFERENCJĄ – żeby potwierdzić, że restore'ują się z Twojego feedu i pakują
    do jednego pliku .exe. Panel „Diagnostyka środowiska” pokazuje ich wersje
    wczytane w runtime z bundla.

    Struktura kodu jest docelowa (docs/architektura.md, rozdz. 5.3): Shell/, Modules/<Moduł>/,
    Shared/{Utils,Models,Views/Templates,Views/Partials}. Granice modułów sprawdza przy każdej
    budowie ../ArchitectureRules.targets; przestrzeń nazw = folder (.editorconfig, IDE0130).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PzlEv</RootNamespace>
    <Version>0.5.3</Version>
    <AssemblyName>PZL-EV</AssemblyName>

    <!-- Model uruchomienia: jeden plik, self-contained, bez instalacji .NET. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF ma natywne biblioteki – muszą trafić do self-extractu single-file. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF nie wspiera trimmingu – zostawiamy wyłączony. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>pl;en</SatelliteResourceLanguages>
    <!-- Reguły stylu z .editorconfig (m.in. przestrzeń nazw = folder) sprawdzane przy budowie. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dokładnie stos docelowy wskazany w założeniach. Wersje dostosuj do
         zatwierdzonego feedu NuGet w PZL (offline cache itp.). -->
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <Import Project="..\ArchitectureRules.targets" />

</Project>
