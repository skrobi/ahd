<UserControl x:Class="PzlEv.Shared.Views.Partials.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PzlEv.Shared.Views.Partials">
    <StackPanel>
        <local:PageHeader Eyebrow="Moduł w przygotowaniu" Title="{Binding Title}"
                          Subtitle="Moduł ma w kodzie miejsce i kontrakt – ekran powstanie przy jego implementacji (tasks/README.md). Poniżej dokumentacja i etapy, które przejmie." />

        <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Dokumentacja" Style="{StaticResource H2}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding Doc}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />

                <StackPanel Margin="0,14,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasStages}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Etapy realizowane przez moduł" Style="{StaticResource H2}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Stages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Code}" Style="{StaticResource MonoText}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Step}" Foreground="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="3" Foreground="{StaticResource Muted}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="bez decyzji człowieka" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanAutoRun}" Value="False">
                                                        <Setter Property="Text" Value="wymaga decyzji człowieka" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <Button Content="Wróć do Pulpitu" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left"
                Command="{Binding Back}" />
    </StackPanel>
</UserControl>
