<UserControl x:Class="PzlEv.Modules.Dashboard.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials">

    <!-- Pigułki (Pill) i kropki etapów (StageDot) rysują szablony wspólne z Shared/Views/Partials/Partials.xaml. -->
    <StackPanel>
        <!-- Nagłówek Pulpitu: tydzień i okres z kalendarza okresów jako kluczowa informacja -->
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Odśwież" Style="{StaticResource Btn}"
                    Command="{Binding Refresh}" />
            <StackPanel>
                <TextBlock Text="Pulpit" Style="{StaticResource H1}" Margin="0,0,0,6" />
                <TextBlock Text="{Binding Eyebrow}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
        <partials:BusyBar DataContext="{Binding Busy}" />

        <!-- Błąd odczytu z bazy -->
        <Border Background="{StaticResource CritSoft}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Crit}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <!-- Karty faz globalnych – klik przechodzi do sekcji (GlobalCard.ModuleKey) -->
        <ItemsControl ItemsSource="{Binding GlobalCards}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Panel}" Margin="0,0,12,0" Cursor="Hand"
                            ToolTip="Kliknij, aby przejść do sekcji">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                          Command="{Binding DataContext.OpenCard, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Border.InputBindings>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag}">
                                    <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="{StaticResource Muted}" />
                                </Border>
                                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" FontSize="15" />
                            </DockPanel>
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="12"
                                       Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Pills}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Wymaga uwagi + Ostatnie zdarzenia -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,12,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right" Style="{StaticResource CountBadge}">
                            <TextBlock Text="{Binding AttentionCount}" FontFamily="{StaticResource FMono}"
                                       Foreground="{StaticResource Muted}" />
                        </Border>
                        <TextBlock Text="Wymaga uwagi – otwarte problemy" Style="{StaticResource H2}" />
                    </DockPanel>
                    <TextBlock Text="Brak otwartych problemów."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Visibility="{Binding NoAttention, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Attention}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <DockPanel>
                                            <ContentControl DockPanel.Dock="Left" Width="110" VerticalAlignment="Top"
                                                            Content="{Binding Tag, Mode=OneWay}" />
                                            <Button DockPanel.Dock="Right" Content="Rozwiązane" Style="{StaticResource Btn}" Padding="6,1" Margin="8,0,0,0"
                                                    VerticalAlignment="Top" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.ResolveProblem, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="Oznacza problem jako rozwiązany (wpis w dzienniku)" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding When, Mode=OneWay}" FontSize="11" Foreground="{StaticResource Muted}"
                                                           FontFamily="{StaticResource FMono}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="‹" Style="{StaticResource Btn}" Padding="8,1" Command="{Binding PrevEvents}" ToolTip="Nowsze" />
                            <TextBlock Text="{Binding EventPageLabel}" FontFamily="{StaticResource FMono}" FontSize="12"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0" />
                            <Button Content="›" Style="{StaticResource Btn}" Padding="8,1" Command="{Binding NextEvents}" ToolTip="Starsze" />
                        </StackPanel>
                        <TextBlock Text="Ostatnie zdarzenia" Style="{StaticResource H2}" />
                    </DockPanel>
                    <TextBlock Text="Brak wpisów w dzienniku." Style="{StaticResource MutedText}"
                               Visibility="{Binding NoEvents, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding PagedEvents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,4">
                                    <StackPanel>
                                        <TextBlock FontSize="11" Foreground="{StaticResource Muted}" FontFamily="{StaticResource FMono}">
                                            <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Where, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Who, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
