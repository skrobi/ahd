<UserControl x:Class="PzlEv.Modules.Cam.Views.CamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials">
    <UserControl.Resources>
        <!-- Kafelek podsumowania (SummaryTile): etykieta, wartość, poziom (Tone) jako kolor wartości -->
        <DataTemplate x:Key="Tile">
            <Border Style="{StaticResource Panel}" MinWidth="130" Margin="0,0,10,10" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{Binding Tone, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
        <!-- Wiersz roku formularza: rok, propozycja, wartość CAM (edycja), różnica, stawka, koszt, błąd -->
        <DataTemplate x:Key="YearRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Year}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ProposalText}" Style="{StaticResource MonoText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Grid.Column="2" Style="{StaticResource Input}" TextAlignment="Right" IsEnabled="{Binding Editable}"
                         Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}" ToolTip="Wartość CAM – liczba (np. 1 250 albo 1250,5)" />
                <TextBlock Grid.Column="3" Text="{Binding DiffText}" Style="{StaticResource MonoText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="4" Text="{Binding RateText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding CostText}" Style="{StaticResource MonoText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="6" Text="{Binding Error}" Foreground="{StaticResource Crit}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <partials:PageHeader Title="CAM" Subtitle="Estymacje WP dla Finansów, zatwierdzanie przez analityka, wyniki EV WP przypisanych do CAM-a" />
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="CAM" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="280" ItemsSource="{Binding Cams}" SelectedItem="{Binding SelectedCam}" DisplayMemberPath="Label"
                          ToolTip="Wersja testowa – wybór CAM-a z listy; później CAM z uprawnień zalogowanego użytkownika" />
                <Button Content="Odśwież" Style="{StaticResource Btn}" Margin="8,0,16,0" Command="{Binding Refresh}" />
                <TextBlock Text="{Binding CycleText}" VerticalAlignment="Center" />
            </WrapPanel>
            <partials:BusyBar DataContext="{Binding Busy}" />
            <TextBlock partials:CopyText.Enabled="True" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
        </StackPanel>

        <TabControl Background="Transparent" BorderThickness="0,1,0,0" Padding="0,12,0,0" SelectedIndex="{Binding SelectedTab}">
            <!-- 1. Estymacje: lista zadań cyklu albo formularz WP -->
            <TabItem Header="Estymacje" Padding="12,4">
                <Grid>
                    <!-- Lista zadań -->
                    <DockPanel Visibility="{Binding IsListing, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <CheckBox DockPanel.Dock="Right" Content="Tylko do zrobienia" IsChecked="{Binding OnlyToDo}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Rows}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Tone, Converter={StaticResource LevelBrush}, ConverterParameter=bg}" CornerRadius="10" Padding="8,1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{Binding Tone, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="WP" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Code}" Foreground="{StaticResource Muted}" FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Do uzupełnienia" Binding="{Binding Missing}" Width="*" />
                                <DataGridTextColumn Header="Stan" Binding="{Binding State}" Width="2*" />
                                <DataGridTextColumn Header="ETC godziny" Binding="{Binding EtcHours}" />
                                <DataGridTextColumn Header="ETC materiały" Binding="{Binding EtcMaterial}" />
                                <DataGridTemplateColumn Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Action}" Style="{StaticResource BtnPrimary}" Padding="10,2"
                                                    Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Formularz WP -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DataContext="{Binding Editor}" Margin="0,0,12,12">
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Left" Content="← Lista WP" Style="{StaticResource Btn}" Margin="0,0,12,0" VerticalAlignment="Top"
                                        Command="{Binding DataContext.Back, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <Border Style="{StaticResource Panel}" Background="{StaticResource CritSoft}" Margin="0,0,0,10"
                                    Visibility="{Binding HasReviewNote, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap"><Run Text="Uwaga analityka: " FontWeight="SemiBold" /><Run Text="{Binding ReviewNote, Mode=OneWay}" /></TextBlock>
                            </Border>

                            <!-- Kontekst WP (tylko odczyt) -->
                            <ItemsControl ItemsSource="{Binding Context}" ItemTemplate="{StaticResource Tile}" ItemsPanel="{StaticResource Wrap}" Margin="0,0,0,6" />

                            <!-- Krok 1: daty prognozy -->
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="1. Prognoza terminów WP" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <TextBlock Text="Start (Forecast)" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <DatePicker SelectedDate="{Binding ForecastStart}" Width="140" Margin="0,0,24,0" IsEnabled="{Binding Editable}" />
                                        <TextBlock Text="Koniec (Forecast)" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <DatePicker SelectedDate="{Binding ForecastFinish}" Width="140" IsEnabled="{Binding Editable}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding FinishNote}" TextWrapping="Wrap" Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FinishShifted}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Propozycja dat: ostatnio wpisana prognoza, bez niej najwcześniejsza i najpóźniejsza DATA_PLAN zleceń AHD. Baseline zmienia tylko analityk (Harmonogram i budżet)." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Krok 2: godziny w latach -->
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="2. Godziny do wykonania (ETC) w latach" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding HoursSource}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" /><ColumnDefinition Width="110" /><ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="100" /><ColumnDefinition Width="140" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Rok" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Grid.Column="1" Text="Propozycja [h]" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="CAM [h]" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="Różnica" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="4" Text="Stawka MPK" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Grid.Column="5" Text="Koszt" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Hours}" ItemTemplate="{StaticResource YearRow}" />
                                </StackPanel>
                            </Border>

                            <!-- Krok 3: materiały w latach -->
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="3. Koszty materiałowe do poniesienia w latach" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding MaterialSource}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" /><ColumnDefinition Width="110" /><ColumnDefinition Width="130" /><ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Rok" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Grid.Column="1" Text="Propozycja" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="CAM" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="Różnica" Style="{StaticResource Eyebrow}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Materials}" ItemTemplate="{StaticResource YearRow}" />
                                </StackPanel>
                            </Border>

                            <!-- Krok 4: uzasadnienie i wysyłka -->
                            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="4. Uzasadnienie i wysyłka do analityka" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding JustificationLabel}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource Input}" Text="{Binding Justification, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Editable}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                                    <ItemsControl ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource Tile}" ItemsPanel="{StaticResource Wrap}" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding Errors}" Foreground="{StaticResource Crit}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Zapisz szkic" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding SaveDraft}" />
                                        <Button Content="Wyślij do analityka" Style="{StaticResource BtnPrimary}" Command="{Binding Submit}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Historia -->
                            <Border Style="{StaticResource Panel}">
                                <StackPanel>
                                    <TextBlock Text="Historia estymacji WP" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock partials:CopyText.Enabled="True" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 2. Postęp estymacji (monitoring finansisty; decyzje – etap „Estymacje CAM” w przebiegu programu) -->
            <TabItem Header="Postęp estymacji" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Odśwież" Style="{StaticResource Btn}" Command="{Binding RefreshProgress}" />
                        <TextBlock Text="{Binding ProgressSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Po programach" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,6" />
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding ProgressByProgram}" IsReadOnly="True" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="*" MinWidth="160" />
                            <DataGridTextColumn Header="Wymagane" Binding="{Binding Required}" />
                            <DataGridTextColumn Header="Zatwierdzone" Binding="{Binding Approved}" />
                            <DataGridTextColumn Header="Wysłane (do decyzji)" Binding="{Binding Sent}" />
                            <DataGridTextColumn Header="U CAM-a" Binding="{Binding AtCam}" />
                            <DataGridTextColumn Header="Brak" Binding="{Binding Missing}" />
                            <DataGridTemplateColumn Header="% zatwierdzonych">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Percent}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{Binding Tone, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Po CAM-ach" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,6" />
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding ProgressByCam}" IsReadOnly="True" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CAM" Binding="{Binding Name}" Width="*" MinWidth="160" />
                            <DataGridTextColumn Header="Wymagane" Binding="{Binding Required}" />
                            <DataGridTextColumn Header="Zatwierdzone" Binding="{Binding Approved}" />
                            <DataGridTextColumn Header="Wysłane (do decyzji)" Binding="{Binding Sent}" />
                            <DataGridTextColumn Header="U CAM-a" Binding="{Binding AtCam}" />
                            <DataGridTextColumn Header="Brak" Binding="{Binding Missing}" />
                            <DataGridTemplateColumn Header="% zatwierdzonych">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Percent}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{Binding Tone, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Wymagane – WP z CAM-em, niezakończone. U CAM-a – szkic albo zwrócona; brak – bez zapisanej estymacji w cyklu." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. Wyniki EV (tylko odczyt) -->
            <TabItem Header="Wyniki EV" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Results}">
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="Zakres" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton GroupName="Scope" Content="Razem" IsChecked="{Binding ScopeAll}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <RadioButton GroupName="Scope" Content="Robocizna" IsChecked="{Binding ScopeLabor}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <RadioButton GroupName="Scope" Content="Materiały" IsChecked="{Binding ScopeMaterial}" Margin="0,0,24,0" VerticalAlignment="Center" />
                            <TextBlock Text="Waluta" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton GroupName="Currency" Content="Programu" IsChecked="{Binding CurrencyProgram}" IsEnabled="{Binding CanUseProgramCurrency}" Margin="0,0,10,0" VerticalAlignment="Center"
                                         ToolTip="Tylko gdy wszystkie programy CAM-a mają tę samą walutę" />
                            <RadioButton GroupName="Currency" Content="PLN" IsChecked="{Binding CurrencyPln}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <RadioButton GroupName="Currency" Content="USD" IsChecked="{Binding CurrencyUsd}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource Tile}" ItemsPanel="{StaticResource Wrap}" />
                        <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Rows}" IsReadOnly="True" Margin="0,4,0,10">
                            <DataGrid.Resources>
                                <Style x:Key="Num" TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Program" Binding="{Binding Program}" />
                                <DataGridTextColumn Header="WP" Binding="{Binding Wp}" />
                                <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*" MinWidth="140" />
                                <DataGridTextColumn Header="Koniec BL → FC" Binding="{Binding Finish}" />
                                <DataGridTextColumn Header="% wyk." Binding="{Binding Complete}" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="% wyd." Binding="{Binding Spent}" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="BAC" Binding="{Binding Bac}" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="BCWS" Binding="{Binding Bcws}" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="BCWP" Binding="{Binding Bcwp}" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="ACWP" Binding="{Binding Acwp}" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="CV" Binding="{Binding Cv}" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="SV" Binding="{Binding Sv}" ElementStyle="{StaticResource Num}" />
                                <DataGridTemplateColumn Header="CPI">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Cpi}" HorizontalAlignment="Right" Foreground="{Binding CpiTone, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="SPI">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Spi}" HorizontalAlignment="Right" Foreground="{Binding SpiTone, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ETC" Binding="{Binding Etc}" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="EAC" Binding="{Binding Eac}" ElementStyle="{StaticResource Num}" />
                                <DataGridTextColumn Header="IEAC (CPI)" Binding="{Binding Ieac}" ElementStyle="{StaticResource Num}" />
                                <DataGridTemplateColumn Header="VAC">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Vac}" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VacNegative}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Crit}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Odchylenia do wyjaśnienia" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Deviations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Border DockPanel.Dock="Left" Width="100" CornerRadius="10" Padding="8,1" Margin="0,0,8,0" VerticalAlignment="Top"
                                                Background="{Binding Tone, Converter={StaticResource LevelBrush}, ConverterParameter=bg}">
                                            <TextBlock Text="{Binding Level}" FontSize="11" FontWeight="Medium" HorizontalAlignment="Center"
                                                       Foreground="{Binding Tone, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" />
                                        </Border>
                                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" – " /><Run Text="{Binding Text, Mode=OneWay}" /></TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
