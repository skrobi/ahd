<UserControl x:Class="PzlEv.Modules.Projects.Views.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials">
    <StackPanel>
        <partials:PageHeader Eyebrow="Projekty" Title="Projekty"
                             Subtitle="Projekt = struktura kontraktu Performance Objectives po stronie CES. Mapowanie CES ↔ P1S jest globalne i nie zależy od projektu.">
            <partials:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Odśwież" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Refresh}" />
                    <Button Content="+ Nowy projekt" Style="{StaticResource BtnPrimary}" Command="{Binding NewProject}" />
                </StackPanel>
            </partials:PageHeader.Actions>
        </partials:PageHeader>
        <partials:BusyBar DataContext="{Binding Busy}" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Border Style="{StaticResource Panel}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource MutedText}" Text="Brak projektów. Utwórz pierwszy projekt kreatorem: dane podstawowe, Performance Objectives, słowniki projektu, foldery, podsumowanie." TextWrapping="Wrap" />
        </Border>
        <DataGrid x:Name="ProjectsGrid" Style="{StaticResource DataTable}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True"
                  MouseDoubleClick="OnDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kod" Binding="{Binding Code}" FontWeight="SemiBold" />
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Typ" Binding="{Binding Type}" />
                <DataGridTextColumn Header="Performance Objectives" Binding="{Binding Objectives}" />
                <DataGridTemplateColumn Header="Gotowość">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding Readiness}" Margin="4,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Aktywny przebieg" Binding="{Binding ActiveRun}" />
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" />
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Otwórz" Style="{StaticResource Btn}" Padding="8,2" Margin="4,2"
                                    Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
