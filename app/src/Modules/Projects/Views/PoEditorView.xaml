<UserControl x:Class="PzlEv.Modules.Projects.Views.PoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials">
    <!-- Edytor nakładki Performance Objectives (DataContext: PoEditorViewModel). Przeciąganie, zwijanie, zaznaczenie
         kilku wierszy, edycja w komórkach i menu „Przenieś do” – PoEditorView.xaml.cs. -->
    <!-- Układ: paski na górze, komunikaty i kontrole na dole, tabela wypełnia resztę (ekran projektu – do dołu okna;
         kreator – najwyżej MaxHeight tabeli). -->
    <DockPanel>
        <!-- Pasek narzędzi (jak w edytorze tekstu): plik | dodawanie | kolejność | usuwanie | zwijanie -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="8,6" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock partials:CopyText.Enabled="True" DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <WrapPanel>
                    <Button Content="Wczytaj Excel (eksport SAP)" Style="{StaticResource BtnPrimary}" Margin="0,2,4,2" Command="{Binding ImportExcel}" />
                    <Button Content="&#xE894;" Style="{StaticResource BtnIcon}" Margin="0,2,4,2" Command="{Binding Clear}" ToolTip="Wyczyść nakładkę" />
                    <Rectangle Width="1" Fill="{StaticResource Line}" Margin="6,4" />
                    <Button Content="&#xE8F4;" Style="{StaticResource BtnIcon}" Margin="0,2,4,2" Command="{Binding AddVirtual}"
                            ToolTip="+ węzeł wirtualny pod zaznaczonym – węzeł raportowy bez odpowiednika w SAP, grupuje elementy; z kodem P1S ELEMENT_P1S.NAZWA.CPLGR wydziela godziny grupy stanowisk z elementu P1S (np. …25.PAINT.W20)" />
                    <Button Content="&#xE710;" Style="{StaticResource BtnIcon}" Margin="0,2,4,2" Command="{Binding AddElement}"
                            ToolTip="+ element CES pod zaznaczonym (dodany ręcznie – wymaga Element CES)" />
                    <Button Content="Grupuj" Style="{StaticResource Btn}" Margin="0,2,4,2" Command="{Binding GroupSelected}"
                            ToolTip="Grupuj w nowy węzeł: nowy węzeł wirtualny w miejscu pierwszego zaznaczonego, zaznaczone (Ctrl / Shift – kilka) stają się jego elementami" />
                    <Rectangle Width="1" Fill="{StaticResource Line}" Margin="6,4" />
                    <Button Content="↑" Style="{StaticResource Btn}" Margin="0,2,4,2" Command="{Binding Up}" ToolTip="Wyżej wśród rodzeństwa" />
                    <Button Content="↓" Style="{StaticResource Btn}" Margin="0,2,4,2" Command="{Binding Down}" ToolTip="Niżej wśród rodzeństwa" />
                    <Button Content="⤒" Style="{StaticResource Btn}" Margin="0,2,4,2" Command="{Binding Top}" ToolTip="Na początek rodzeństwa" />
                    <Button Content="⤓" Style="{StaticResource Btn}" Margin="0,2,4,2" Command="{Binding Bottom}" ToolTip="Na koniec rodzeństwa" />
                    <Button Content="⇤" Style="{StaticResource Btn}" Margin="0,2,4,2" Command="{Binding Outdent}" ToolTip="Poziom wyżej – za węzeł nadrzędny" />
                    <Rectangle Width="1" Fill="{StaticResource Line}" Margin="6,4" />
                    <Button Content="&#xE74D;" Style="{StaticResource BtnIcon}" Margin="0,2,4,2" Command="{Binding Remove}"
                            ToolTip="Usuń zaznaczony węzeł; jego elementy przechodzą poziom wyżej" />
                    <Rectangle Width="1" Fill="{StaticResource Line}" Margin="6,4" />
                    <Button Content="&#xE70D;" Style="{StaticResource BtnIcon}" Margin="0,2,4,2" Command="{Binding ExpandAll}" ToolTip="Rozwiń wszystko" />
                    <Button Content="&#xE70E;" Style="{StaticResource BtnIcon}" Margin="0,2,4,2" Command="{Binding CollapseAll}" ToolTip="Zwiń wszystko" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding MappingInfo}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="Odznacz" Style="{StaticResource Btn}" Padding="8,2" Command="{Binding Unselect}" />
            <TextBlock Text="{Binding SelectionText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <Border DockPanel.Dock="Top" x:Name="RootDrop" AllowDrop="True" Drop="OnDropRoot" DragOver="OnDragOver" Background="{StaticResource Surface2}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="8,4" Margin="0,0,0,2">
            <TextBlock Text="⤒ korzeń" ToolTip="Upuść tutaj wiersz, aby przenieść go na najwyższy poziom" Style="{StaticResource MutedText}" />
        </Border>
        <!-- Pod tabelą (DockPanel – od dołu): komunikat edytora, wynik wczytania pliku, kontrola nakładki -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Margin="0,8,0,0" MaxHeight="220" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Kontrola nakładki" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Issues}" />
                </ScrollViewer>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Margin="0,8,0,0" MaxHeight="220" Visibility="{Binding HasImportIssues, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Wynik wczytania pliku" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ImportIssues}" />
                </ScrollViewer>
            </StackPanel>
        </Border>
        <TextBlock partials:CopyText.Enabled="True" DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <!-- Nazwa, Element CES i P1S – edycja w komórce (dwuklik, F2 albo pisanie; Enter zatwierdza, Esc anuluje) -->
        <DataGrid x:Name="NodesGrid" Style="{StaticResource DataTable}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  IsReadOnly="False" AllowDrop="True" Drop="OnDropRow" DragOver="OnDragOver" MaxHeight="560"
                  SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                  BeginningEdit="OnBeginningEdit" CellEditEnding="OnCellEditEnding"
                  PreviewMouseRightButtonDown="OnRightButtonDown" ContextMenuOpening="OnContextMenuOpening">
            <DataGrid.ContextMenu>
                <ContextMenu />
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="NameColumn" Header="Nazwa" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                <TextBlock Text="{Binding Expander}" Width="14" Cursor="Hand" Foreground="{StaticResource Muted}"
                                           ToolTip="{Binding ExpanderHint}" MouseLeftButtonDown="OnToggle" />
                                <TextBlock Text="⋮⋮" Cursor="SizeAll" Foreground="{StaticResource Muted}" Margin="2,0,6,0"
                                           ToolTip="Przeciągnij, aby przenieść" PreviewMouseLeftButtonDown="OnGripDown" PreviewMouseMove="OnGripMove" />
                                <Border Style="{StaticResource Tag}" Margin="0,0,6,0"
                                        Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="węzeł" FontSize="11" />
                                </Border>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding CollapsedInfo}" Foreground="{StaticResource Muted}" Margin="6,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=Explicit}" Margin="{Binding Indent}" Padding="34,0,0,0" BorderThickness="0"
                                     Loaded="OnNameBoxLoaded" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="WbsColumn" Header="Element CES" Binding="{Binding WbsElement}" FontFamily="{StaticResource FMono}" />
                <DataGridTextColumn Header="P1S (Legacy WBS)" Binding="{Binding LegacyWbs}" FontFamily="{StaticResource FMono}" />
                <DataGridTextColumn Header="Performance Obligation" Binding="{Binding PerformanceObligation}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
