<UserControl x:Class="PzlEv.Modules.Projects.Views.DictionaryPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Słownik projektu (DataContext: DictionaryPanelViewModel): stan, plik, różnice, wynik walidacji, akcje. -->
    <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ContentControl Content="{Binding StatusPill}" VerticalAlignment="Center" />
                    <Button Content="Wczytaj" Style="{StaticResource Btn}" Margin="6,0,0,0" Command="{Binding Load}"
                            Visibility="{Binding CanLoad, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Zatwierdź wczytanie" Style="{StaticResource BtnPrimary}" Margin="6,0,0,0" Command="{Binding Apply}"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Usuń wczytanie" Style="{StaticResource Btn}" Margin="6,0,0,0" Command="{Binding Remove}"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="15" />
                    <TextBlock Style="{StaticResource MutedText}">
                        <Run Text="{Binding Requirement, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding LastChange, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
            <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource MonoText}">
                    <Run Text="{Binding File, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PreviewSummary, Mode=OneWay}" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Lines}" Margin="0,4,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Issues}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
