<UserControl x:Class="PzlEv.Modules.Projects.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials"
             xmlns:views="clr-namespace:PzlEv.Modules.Projects.Views">
    <!-- Ekran Projekt (DataContext: ProjectDetailViewModel) – docs/funkcjonalnosc.md, rozdz. 2 i F02. -->
    <UserControl.Resources>
        <DataTemplate x:Key="Kpi">
            <Border Style="{StaticResource Panel}" Width="190" Margin="0,0,12,12" ToolTip="{Binding Hint}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pending}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- Tabela wybranego słownika projektu (DataContext: ProjectDetailViewModel) – zakładki „Słowniki projektu” i „Konfiguracja” -->
        <DataTemplate x:Key="DictionaryEditor">
            <StackPanel>
                <!-- Stan słownika, wczytanie z Excela z podglądem różnic -->
                <views:DictionaryPanelView DataContext="{Binding SelectedDictionary}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Dodaj wiersz" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding AddDictionaryRow}" />
                    <Button Content="Usuń wiersze" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding RemoveDictionaryRow}" ToolTip="Usuwa wiersze zaznaczonych komórek (Ctrl+minus)" />
                    <Button Content="Cofnij" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Table.Undo}" ToolTip="Cofa ostatnią zmianę w tabeli (Ctrl+Z)" />
                    <Button Content="Odrzuć zmiany" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding DiscardDictionary}" />
                    <Button Content="Zapisz" Style="{StaticResource BtnPrimary}" Command="{Binding SaveDictionary}" />
                    <TextBlock Text="Filtr" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{StaticResource Muted}" />
                    <TextBox Width="180" Style="{StaticResource Input}" Text="{Binding Table.Filter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <partials:DictionaryGrid DataContext="{Binding Table}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <!-- Wysokość ekranu = widoczny obszar strony (ScrollViewer powłoki); zakładki wypełniają resztę (wiersz *) – tabela
         struktury i edytor Performance Objectives sięgają do dołu okna bez liczenia wysokości w kodzie; dłuższe zakładki
         przewijają się wewnątrz. -->
    <Grid Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <partials:PageHeader Title="{Binding Title}" Subtitle="{Binding Subtitle}">
            <partials:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RunProgress}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="320"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding RunProgress}" />
                    <Button Content="Uruchom przebieg" Style="{StaticResource BtnPrimary}" Margin="0,0,12,0" Command="{Binding StartRun}"
                            ToolTip="Przebieg w tle: import źródeł projektu, przypięcie danych ACTUALS, kontrole (liczba danych, odchylenia, nowe cost elementy, netowanie do 0); powiadomienie Windows po zakończeniu" />
                    <ContentControl Content="{Binding ReadinessPill}" VerticalAlignment="Center" Margin="0,0,12,0"
                                    ToolTip="Gotowość do przebiegu – szczegóły w zakładce Wskaźniki" />
                    <Button Content="← Lista projektów" Style="{StaticResource Btn}" Command="{Binding Back}" />
                </StackPanel>
            </partials:PageHeader.Actions>
        </partials:PageHeader>
        <!-- Z kiedy są dane: RABIT (ACTUALS) i produkcja (PZLPROD) – osobna linia pod nagłówkiem (tytuł i opis mają całą szerokość) -->
        <WrapPanel Grid.Row="1" Margin="0,-12,0,12">
            <Border Style="{StaticResource Tag}" VerticalAlignment="Center" Margin="0,0,8,4" ToolTip="{Binding DataInfoDetails}">
                <TextBlock Text="{Binding DataInfo}" FontSize="12" />
            </Border>
            <Border Style="{StaticResource Tag}" VerticalAlignment="Center" Margin="0,0,8,4" ToolTip="{Binding ProductionDetails}">
                <TextBlock Text="{Binding ProductionInfo}" FontSize="12" />
            </Border>
        </WrapPanel>
        <!-- Komunikat w stałym miejscu (jedna linia o stałej wysokości, pełna treść w podpowiedzi): operacja w toku albo wynik
             ostatniej operacji – pokazanie i ukrycie nie przesuwa zakładek ani tabeli struktury. -->
        <Grid Grid.Row="2" Height="22" Margin="0,0,0,6">
            <DockPanel Visibility="{Binding Busy.IsBusy, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Busy.Display}">
                <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="4" Margin="0,0,10,0" BorderThickness="0"
                             VerticalAlignment="Center" Foreground="{StaticResource Info}" Background="{StaticResource Surface}" />
                <TextBlock Text="{Binding Busy.Display}" Foreground="{StaticResource Info}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock Text="{Binding StatusLine}" ToolTip="{Binding StatusLine}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Busy.IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusLine}" Value="">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <!-- Wskaźniki: sumy projektu teraz, wskaźniki EV po przebiegach; gotowość do przebiegu zwinięta -->
            <TabItem Header="Wskaźniki" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Grupy wskaźników jak w tabeli struktury (Operational EV, Materials, Financial EV) -->
                    <ItemsControl ItemsSource="{Binding Kpis}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,24,4">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource Kpi}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Margin="0,4,0,0">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Gotowość do przebiegu" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ContentControl Content="{Binding ReadinessPill}" />
                            </StackPanel>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Readiness}" Margin="0,8,0,0" />
                    </Expander>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Struktura: Performance Objectives z rozwinięciem P1S, WP, CAM, budżet i daty – edycja w komórkach -->
            <TabItem Header="Struktura" Padding="12,4">
                <Grid>
                    <!-- Przegląd: pasek narzędzi, pod nim tabela struktury do dołu okna -->
                    <DockPanel Visibility="{Binding IsViewingStructure, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Structure.SummaryText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       ToolTip="{Binding MappingInfo}" />
                            <!-- Ikony z opisem w podpowiedzi (Segoe MDL2 / Fluent Icons) -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#xE70F;" Style="{StaticResource BtnIconPrimary}" Command="{Binding EditObjectives}"
                                        AutomationProperties.Name="Edytuj Performance Objectives"
                                        ToolTip="Edytuj Performance Objectives – edytor jak w kreatorze: przeciąganie, przesuwanie, usuwanie, węzły wirtualne, podmiana z Excela" />
                                <Button Content="&#xE710;" Style="{StaticResource BtnIcon}" Command="{Binding AddFromExcel}"
                                        AutomationProperties.Name="Dołóż z Excela (eksport SAP)"
                                        ToolTip="Dołóż z Excela (eksport SAP) – dokłada elementy, których projekt jeszcze nie ma (np. kolejne Project definition); istniejąca struktura zostaje bez zmian" />
                                <Button Content="&#xE896;" Style="{StaticResource BtnIcon}" Command="{Binding ExportStructure}"
                                        AutomationProperties.Name="Pobierz strukturę do Excela"
                                        ToolTip="Pobierz strukturę do Excela – całe drzewo (także zwinięte wiersze) ze wszystkimi kolumnami: WP, CAM, Cost Category, budżet, daty, ACWP, braki; kolumny do uzupełnienia wyróżnione na żółto" />
                                <Button Content="&#xE898;" Style="{StaticResource BtnIcon}" Margin="0,0,12,0" Command="{Binding ImportStructure}"
                                        AutomationProperties.Name="Wczytaj strukturę z Excela"
                                        ToolTip="Wczytaj strukturę z Excela – pobrany arkusz „Struktura” uzupełniony ręcznie: WP, CAM (numer znaczka), Cost Category, Baseline Start / Finish, BAC Hours baseline, BAC Material, BAC Cost; puste komórki bez zmiany, przed zapisem podsumowanie" />
                                <Button Content="&#xE70D;" Style="{StaticResource BtnIcon}" Command="{Binding Structure.ExpandAll}"
                                        AutomationProperties.Name="Rozwiń wszystko" ToolTip="Rozwiń wszystko" />
                                <Button Content="&#xE70E;" Style="{StaticResource BtnIcon}" Margin="0,0,12,0" Command="{Binding Structure.CollapseAll}"
                                        AutomationProperties.Name="Zwiń wszystko" ToolTip="Zwiń wszystko" />
                                <Button Content="&#xE8B5;" Style="{StaticResource BtnIcon}" Command="{Binding ImportSources}"
                                        AutomationProperties.Name="Importuj źródła projektu"
                                        ToolTip="Importuj źródła projektu – pliki definicji ze słownika „Źródła danych” (tylko nowe wersje), potem odświeżenie kosztów i produkcji" />
                                <Button Content="&#xE72C;" Style="{StaticResource BtnIcon}" Command="{Binding RefreshMapping}"
                                        AutomationProperties.Name="Odśwież P1S i koszty"
                                        ToolTip="Odśwież P1S i koszty – ponowny odczyt struktury P1S (PZLPROD), produkcji i kosztów ACWP z ostatniego importu ACTUALS" />
                                <Button Content="&#xE7A7;" Style="{StaticResource BtnIcon}" Command="{Binding Structure.Undo}"
                                        AutomationProperties.Name="Cofnij wklejenie"
                                        ToolTip="Cofnij wklejenie – cofa ostatnie wklejenie, wyczyszczenie (Delete) albo wypełnienie w dół (Ctrl+D) i zapisuje wartości sprzed zmiany (Ctrl+Z)" />
                                <Button Content="&#xE711;" Style="{StaticResource BtnIcon}" Command="{Binding Structure.RevertChanges}"
                                        AutomationProperties.Name="Odrzuć niezapisane"
                                        ToolTip="Odrzuć niezapisane – cofa zmiany wierszy, których nie udało się zapisać" />
                                <Button Content="&#xE897;" Style="{StaticResource BtnIcon}" Margin="12,0,0,0" Click="OnStructureHelp"
                                        AutomationProperties.Name="Skróty i opis kolumn"
                                        ToolTip="Skróty i opis kolumn – obsługa tabeli jak w Excelu i wyjaśnienie każdej kolumny (osobne okno)" />
                            </StackPanel>
                        </DockPanel>
                        <views:StructureView DataContext="{Binding Structure}" />
                    </DockPanel>

                    <!-- Edycja Performance Objectives: edytor z kreatora (tabela do dołu okna) -->
                    <DockPanel Visibility="{Binding IsEditingObjectives, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Anuluj" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding CancelObjectives}" />
                                <Button Content="Zapisz Performance Objectives" Style="{StaticResource BtnPrimary}" Command="{Binding SaveObjectives}" />
                            </StackPanel>
                            <TextBlock Text="Edycja Performance Objectives" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <views:PoEditorView DataContext="{Binding Objectives}" FillPage="True" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Raporty: tabela – przycisk raportu po lewej, opis po prawej -->
            <TabItem Header="Raporty" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Panel}" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Column="0" Content="Raport kosztów (Excel)" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Margin="12" Command="{Binding ExportCostReport}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,12,12,12" TextWrapping="Wrap"
                                   Text="Koszty ostatniego importu ACTUALS: Project definition × Cost Element, ostatni okres i lata (PLN), bez wykluczeń projektu." />
                        <Button Grid.Row="1" Grid.Column="0" Content="Raport kosztów CES (Excel)" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Margin="12,0,12,12" Command="{Binding ExportCasCostReport}"
                                Visibility="{Binding IsCas, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,12" TextWrapping="Wrap"
                                   Visibility="{Binding IsCas, Converter={StaticResource BoolToVisibility}}"
                                   Text="Raport kosztów z narzutami CAS w formułach Excela: pule według grupy narzutowej elementu kosztowego (słownik Cost Category), wskaźniki obowiązujące w okresie kolumny (słownik „Wskaźniki narzutu CAS”) – wiersz wskaźników nad nagłówkiem można zmienić w pliku." />
                    </Grid>
                </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Słowniki projektu: lista słowników i tabela wybranego słownika z edycją w komórkach (jak ekran Słowniki) -->
            <TabItem Header="Słowniki projektu" Padding="12,4" IsSelected="{Binding DictionaryTabOpen, Mode=OneWayToSource}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,0">
                        <Border Style="{StaticResource Panel}" Padding="8" VerticalAlignment="Top">
                            <ListBox ItemsSource="{Binding ProjectDictionaryList}" SelectedItem="{Binding SelectedProjectDictionary}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="220" Margin="0,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" />
                                            <ContentControl Content="{Binding StatusPill}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Button Content="Pobierz słowniki (Excel)" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Command="{Binding ExportDictionaries}"
                                ToolTip="Wszystkie słowniki projektu w jednym skoroszycie – popraw i wczytaj ponownie (przed zapisem zobaczysz różnice)" />
                    </StackPanel>

                    <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource DictionaryEditor}" />
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Konfiguracja: źródła danych projektu (definicje z Administracji) i parametry projektu -->
            <TabItem Header="Konfiguracja" Padding="12,4" IsSelected="{Binding ConfigTabOpen, Mode=OneWayToSource}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Panel}" Padding="8" VerticalAlignment="Top" Margin="0,0,16,0">
                        <ListBox ItemsSource="{Binding ConfigDictionaryList}" SelectedItem="{Binding SelectedConfigDictionary}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="220" Margin="0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" />
                                        <ContentControl Content="{Binding StatusPill}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DictionaryEditor}" />
                        <TextBlock Text="Definicje źródeł projektu (Administracja)" Style="{StaticResource Eyebrow}" Margin="0,16,0,6" />
                        <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding SourceDefinitions}" IsReadOnly="True" HorizontalAlignment="Left" MinWidth="480">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Definicja" Binding="{Binding Code}" />
                                <DataGridTextColumn Header="Prefiks pliku" Binding="{Binding Prefix}" />
                                <DataGridTextColumn Header="Typ raportu" Binding="{Binding ReportType}" />
                                <DataGridTextColumn Header="Parser" Binding="{Binding Parser}" />
                                <DataGridCheckBoxColumn Header="Aktywna" Binding="{Binding Active}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Przebiegi -->
            <TabItem Header="Przebiegi" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding RunPins}" SelectedItem="{Binding SelectedPin}" IsReadOnly="True" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Przebieg" Binding="{Binding Code}" />
                            <DataGridTextColumn Header="#" Binding="{Binding PinNo}" />
                            <DataGridTextColumn Header="Start" Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                            <DataGridTextColumn Header="Kto" Binding="{Binding StartedBy}" />
                            <DataGridTextColumn Header="Stan" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="Błędy" Binding="{Binding Errors}" />
                            <DataGridTextColumn Header="Ostrz." Binding="{Binding Warnings}" />
                            <DataGridTextColumn Header="Wiersze" Binding="{Binding Rows, StringFormat=#\,0}" />
                            <DataGridTextColumn Header="Podsumowanie" Binding="{Binding Summary}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="1" Style="{StaticResource DataTable}" ItemsSource="{Binding RunIssues}" IsReadOnly="True" Margin="0,12,0,0" MaxHeight="520">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Poziom" Binding="{Binding Level}" />
                            <DataGridTextColumn Header="Kontrola" Binding="{Binding CheckName}" />
                            <DataGridTextColumn Header="Element" Binding="{Binding Element}" />
                            <DataGridTextColumn Header="Opis" Binding="{Binding Message}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Kwota" Binding="{Binding Amount, StringFormat=#\,0.00}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Foldery -->
            <TabItem Header="Foldery" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Utwórz brakujące foldery" Style="{StaticResource Btn}" Command="{Binding CreateFolders}" />
                        <TextBlock Text="Struktura folderów" Style="{StaticResource H2}" />
                    </DockPanel>
                    <Border Background="{StaticResource Surface2}" Padding="10" Margin="0,0,0,8">
                        <TextBlock Text="{Binding FolderPreview}" FontFamily="{StaticResource FMono}" />
                    </Border>
                    <TextBlock Text="Zgłoszenie do IT (dostęp CAM do folderu Zwrocone)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource Input}" Text="{Binding ItRequest, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
