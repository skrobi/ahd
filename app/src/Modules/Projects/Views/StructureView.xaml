<UserControl x:Class="PzlEv.Modules.Projects.Views.StructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tabela struktury projektu (DataContext: StructureViewModel). Kolumny i edycja – StructureView.xaml.cs. -->
    <UserControl.Resources>
        <DataTemplate x:Key="NameCell">
            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                <Button Content="{Binding Glyph}" Width="18" Padding="0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource Muted}" Cursor="Hand" Click="OnToggle" Focusable="False" />
                <Border Style="{StaticResource Tag}" Margin="0,0,6,0" Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding VirtualTag}" FontSize="11" />
                </Border>
                <TextBlock Text="{Binding [Name]}" VerticalAlignment="Center" ToolTip="{Binding Note}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsObjective}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGreyed}" Value="True">
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="NameEdit">
            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" FocusManager.FocusedElement="{Binding ElementName=NameBox}">
                <TextBlock Text="{Binding Glyph}" Width="18" Margin="0,0,4,0" Foreground="{StaticResource Muted}" />
                <TextBox x:Name="NameBox" Text="{Binding [Name], UpdateSourceTrigger=PropertyChanged}" MinWidth="200" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="WpCell">
            <!-- Jedno kliknięcie zmienia znacznik i zapisuje wiersz (OnWpClick); w wierszu bez kodu P1S – brak pola. -->
            <CheckBox IsChecked="{Binding IsWp, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Click="OnWpClick" Focusable="False"
                      Visibility="{Binding CanEditWp, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="WP – element P1S ma koszty i budżet (odznaczenie usuwa przypisanie i harmonogram WP)" />
        </DataTemplate>
        <DataTemplate x:Key="GapCell">
            <TextBlock Text="⚠" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" ToolTip="{Binding Gap}"
                       Visibility="{Binding HasGap, Converter={StaticResource BoolToVisibility}}" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <!-- Wynik ostatniej operacji na komórkach (wklejenie, Delete) – nad tabelą; pod tabelą nic (tabela do dołu okna).
             Skróty i opis kolumn – przycisk „?” na pasku nad tabelą (StructureHelpWindow). -->
        <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Info}" Margin="0,0,0,4" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!-- Zaznaczanie komórek jak w Excelu (tylko ta tabela – styl DataTable i edytor Performance Objectives bez zmian). -->
        <DataGrid x:Name="RowsGrid" Style="{StaticResource DataTable}" ItemsSource="{Binding Rows}"
                  MinHeight="320" FrozenColumnCount="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  CanUserSortColumns="False" CanUserReorderColumns="False" SelectionUnit="Cell" SelectionMode="Extended"
                  ClipboardCopyMode="ExcludeHeader"
                  EnableRowVirtualization="True" EnableColumnVirtualization="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  BeginningEdit="OnBeginningEdit" PreparingCellForEdit="OnPreparingCellForEdit" CellEditEnding="OnCellEditEnding"
                  RowEditEnding="OnRowEditEnding" CurrentCellChanged="OnCurrentCellChanged" PreviewKeyDown="OnPreviewKeyDown"
                  LostKeyboardFocus="OnLostKeyboardFocus" IsVisibleChanged="OnIsVisibleChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- Wiersz z niezapisanymi zmianami (zapis w toku albo nieudany – komunikat nad tabelą). -->
                        <DataTrigger Binding="{Binding HasChanges}" Value="True">
                            <Setter Property="Background" Value="{StaticResource WarnSoft}" />
                            <Setter Property="ToolTip" Value="Niezapisane zmiany – zapis w toku albo nieudany (komunikat nad tabelą); „Odrzuć niezapisane” cofa" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </StackPanel>
</UserControl>
