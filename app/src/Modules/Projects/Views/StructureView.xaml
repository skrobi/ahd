<UserControl x:Class="PzlEv.Modules.Projects.Views.StructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tabela struktury projektu (DataContext: StructureViewModel). Kolumny i edycja – StructureView.xaml.cs. -->
    <UserControl.Resources>
        <DataTemplate x:Key="NameCell">
            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                <Button Content="{Binding Glyph}" Width="18" Padding="0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource Muted}" Cursor="Hand" Click="OnToggle" Focusable="False" />
                <Border Style="{StaticResource Tag}" Margin="0,0,6,0" Visibility="{Binding IsVirtual, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="węzeł" FontSize="11" />
                </Border>
                <TextBlock Text="{Binding [Name]}" VerticalAlignment="Center" ToolTip="{Binding Note}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsObjective}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsGreyed}" Value="True">
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="NameEdit">
            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" FocusManager.FocusedElement="{Binding ElementName=NameBox}">
                <TextBlock Text="{Binding Glyph}" Width="18" Margin="0,0,4,0" Foreground="{StaticResource Muted}" />
                <TextBox x:Name="NameBox" Text="{Binding [Name], UpdateSourceTrigger=PropertyChanged}" MinWidth="200" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="GapCell">
            <TextBlock Text="⚠" Foreground="{StaticResource Warn}" HorizontalAlignment="Center" ToolTip="{Binding Gap}"
                       Visibility="{Binding HasGap, Converter={StaticResource BoolToVisibility}}" />
        </DataTemplate>
    </UserControl.Resources>
    <DataGrid x:Name="RowsGrid" Style="{StaticResource DataTable}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
              MaxHeight="640" FrozenColumnCount="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
              CanUserSortColumns="False" CanUserReorderColumns="False" SelectionUnit="FullRow"
              EnableRowVirtualization="True" EnableColumnVirtualization="True"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
              BeginningEdit="OnBeginningEdit" RowEditEnding="OnRowEditEnding" />
</UserControl>
