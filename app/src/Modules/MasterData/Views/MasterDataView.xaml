<UserControl x:Class="PzlEv.Modules.MasterData.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials"
             xmlns:views="clr-namespace:PzlEv.Modules.MasterData.Views">
    <StackPanel>
        <partials:PageHeader Title="Słowniki" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Lista słowników; pod nią podgląd struktury P1S (PZLPROD) -->
            <StackPanel Margin="0,0,16,0">
            <Border Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="8">
                <ListBox ItemsSource="{Binding Dictionaries}" SelectedItem="{Binding SelectedDictionary}"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Width="190" Margin="0,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource MonoText}"
                                           Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Button Content="Struktura P1S (PZLPROD)" Style="{StaticResource Btn}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                    Command="{Binding OpenP1s}" ToolTip="Drzewo WBS z PZLPROD (LOG.WBS) – tylko do odczytu" />
            </StackPanel>

            <Border Grid.Column="1" Visibility="{Binding ShowP1s, Converter={StaticResource BoolToVisibility}}">
                <views:P1sStructureView DataContext="{Binding P1s}" />
            </Border>

            <StackPanel Grid.Column="1" Visibility="{Binding ShowDictionary, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Spec.Name}" Style="{StaticResource H2}" />

                <!-- Akcje -->
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Pobierz do Excela" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Export}" />
                        <Button Content="Wczytaj z Excela" Style="{StaticResource Btn}" Command="{Binding Import}" />
                        <Button Content="Dodaj z HR" Style="{StaticResource Btn}" Margin="8,0,0,0" Command="{Binding ImportFromHr}"
                                Visibility="{Binding IsPersons, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Szukaj pracowników PZLHRPROD (numer znaczka / USRID, PERNR, imię i nazwisko, e-mail, dział) i dodaj wybranych – podgląd przed zapisem; nic nie jest usuwane" />
                        <Button Content="Uzupełnij z ACTUALS" Style="{StaticResource Btn}" Margin="8,0,0,0" Command="{Binding FillFromActuals}"
                                Visibility="{Binding IsCostCategory, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Dopisuje cost elementy z całego ostatniego importu ACTUALS, których nie ma w słowniku (podgląd przed zapisem; nic nie jest usuwane) – Cost Category i „Rozliczeniowy” uzupełnia finansista" />
                        <Button Content="Formuły narzutów" Style="{StaticResource Btn}" Margin="8,0,0,0" Command="{Binding EditFormulas}"
                                Visibility="{Binding IsCasBurden, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Macierz grupy narzutowe × kategorie: zaznaczone pole – kategoria naliczana w grupie; kliknięcie otwiera edytor formuły z klocków" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Dodaj wiersz" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding AddRow}" />
                        <Button Content="Usuń wiersze" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding RemoveRow}" ToolTip="Usuwa wiersze zaznaczonych komórek (Ctrl+minus)" />
                        <Button Content="Cofnij" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Table.Undo}" ToolTip="Cofa ostatnią zmianę w tabeli (Ctrl+Z)" />
                        <Button Content="Odrzuć zmiany" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Discard}" />
                        <Button Content="Zapisz" Style="{StaticResource BtnPrimary}" Command="{Binding Save}" />
                        <TextBlock Text="Filtr" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{StaticResource Muted}" />
                        <TextBox Width="180" Style="{StaticResource Input}" Text="{Binding Table.Filter, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </DockPanel>
                <partials:BusyBar DataContext="{Binding Busy}" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />

                <!-- Wiersze słownika i wynik walidacji: wspólna tabela słownika (Shared/Views/Partials/DictionaryGrid) -->
                <partials:DictionaryGrid DataContext="{Binding Table}" />

                <!-- Podgląd wczytania z Excela -->
                <Border Style="{StaticResource Panel}" Margin="0,12,0,0" BorderBrush="{StaticResource Accent}"
                        Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding PreviewTitle}" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding PreviewLines}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding PreviewIssues}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Zatwierdź wczytanie" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Command="{Binding ApplyImport}" />
                            <Button Content="Anuluj" Style="{StaticResource Btn}" Command="{Binding CancelImport}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Historia zaznaczonego wiersza -->
                <Border Style="{StaticResource Panel}" Margin="0,12,0,0"
                        Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Historia wiersza" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,6" />
                        <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding History}" IsReadOnly="True" MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Kiedy" Binding="{Binding When}" />
                                <DataGridTextColumn Header="Kto" Binding="{Binding Who}" />
                                <DataGridTextColumn Header="Wartości" Binding="{Binding Values}" Width="*" />
                                <DataGridTextColumn Header="Wersja" Binding="{Binding Note}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
