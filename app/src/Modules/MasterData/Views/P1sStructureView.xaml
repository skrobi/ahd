<UserControl x:Class="PzlEv.Modules.MasterData.Views.P1sStructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials"
             xmlns:vm="clr-namespace:PzlEv.Modules.MasterData.ViewModels">
    <!-- Struktura P1S z PZLPROD – tylko do odczytu (DataContext: P1sStructureViewModel) -->
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:P1sTreeItem}" ItemsSource="{Binding Children, Mode=OneWay}">
            <TextBlock x:Name="Title" Text="{Binding Title, Mode=OneWay}" />
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGreyed, Mode=OneWay}" Value="True">
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Muted}" />
                    <Setter TargetName="Title" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Struktura P1S (PZLPROD)" Style="{StaticResource H2}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Odśwież" Style="{StaticResource Btn}" Command="{Binding Refresh}" />
            <TextBlock Text="Szukaj" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{StaticResource Muted}" />
            <TextBox Width="240" Style="{StaticResource Input}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>
        <partials:BusyBar DataContext="{Binding Busy}" />
        <Border Style="{StaticResource Panel}" Padding="8" Margin="0,0,0,8"
                Visibility="{Binding HasMatches, Converter={StaticResource BoolToVisibility}}">
            <ListBox ItemsSource="{Binding Matches}" DisplayMemberPath="Label" MaxHeight="200" BorderThickness="0" Background="Transparent" />
        </Border>
        <Border Style="{StaticResource Panel}" Padding="8">
            <TreeView ItemsSource="{Binding Tree, Mode=OneWay}" Height="560" BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>
    </StackPanel>
</UserControl>
