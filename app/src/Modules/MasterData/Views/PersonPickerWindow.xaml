<Window x:Class="PzlEv.Modules.MasterData.Views.PersonPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj osoby z HR" Width="900" Height="620" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
    <!-- Szukanie pracowników PZLHRPROD i lista osób do dodania (DataContext: PersonPickerViewModel) -->
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource Input}" Margin="0,0,0,10"
                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Anuluj" Style="{StaticResource Btn}" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Zatwierdź" Style="{StaticResource BtnPrimary}" Click="OnConfirm" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Wyniki szukania: „Dodaj” po prawej -->
            <Border Style="{StaticResource Panel}" Padding="8" Margin="0,0,12,0">
                <ListBox ItemsSource="{Binding Results}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <Button DockPanel.Dock="Right" Content="Dodaj" Style="{StaticResource Btn}" Padding="10,2" VerticalAlignment="Center"
                                        CommandParameter="{Binding}" Command="{Binding DataContext.Add, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Blocked}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Person.FullName}" FontWeight="Medium" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Lista do dodania -->
            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding QueueText}" FontWeight="SemiBold" Margin="4,0,0,6" />
                    <ListBox ItemsSource="{Binding Queue}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Content="Usuń" Style="{StaticResource Btn}" Padding="8,2" VerticalAlignment="Center"
                                            CommandParameter="{Binding}" Command="{Binding DataContext.Remove, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Usrid}" Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
