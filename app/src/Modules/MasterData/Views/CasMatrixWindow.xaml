<Window x:Class="PzlEv.Modules.MasterData.Views.CasMatrixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials"
        Title="Formuły narzutów CAS" Width="1320" Height="720" MinWidth="900" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
    <!-- Macierz grupy narzutowe × pule (DataContext: CasMatrixViewModel); kolumny pul – code-behind -->
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Formuły narzutów CAS" Style="{StaticResource H2}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Wiersz – grupa narzutowa, kolumna – pula. Zaznaczone pole: pula naliczana w grupie. Kliknij pole, aby zbudować albo zmienić formułę z klocków (podpowiedź pokazuje formułę). Nazwy grup i pul zmienia się w ich słownikach – tu są widoczne od razu." />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Odrzuć zmiany" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Discard}" />
                <Button Content="Zapisz" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Command="{Binding Save}" />
                <Button Content="Zamknij" Style="{StaticResource Btn}" IsCancel="True" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <partials:BusyBar DockPanel.Dock="Top" DataContext="{Binding Busy}" />
        <DataGrid x:Name="Matrix" Style="{StaticResource DataTable}" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                  SelectionUnit="Cell" FrozenColumnCount="2" />
    </DockPanel>
</Window>
