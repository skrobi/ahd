<UserControl x:Class="PzlEv.Modules.Administration.Views.AdministrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,10,4" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <partials:PageHeader Eyebrow="Konfiguracja importu" Title="Administracja"
                             Subtitle="Definicje źródeł (rozpoznanie pliku po prefiksie, układ kolumn, parser) i lokalizacje RABIT. Zmiany mają historię; nic nie jest usuwane – dezaktywacja wyłącza element z importu." />

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Border Style="{StaticResource Panel}" Margin="0,0,0,12"
                Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Issues}" />
        </Border>

        <!-- Definicje źródeł -->
        <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Nowa definicja" Style="{StaticResource Btn}" Command="{Binding NewDefinition}" />
                    <TextBlock Text="Definicje źródeł" Style="{StaticResource H2}" />
                </DockPanel>
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}"
                          IsReadOnly="True" MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}" />
                        <DataGridTextColumn Header="Prefiks" Binding="{Binding Prefix}" />
                        <DataGridTextColumn Header="Typ raportu" Binding="{Binding ReportType}" Width="*" />
                        <DataGridTextColumn Header="Parser" Binding="{Binding Parser}" />
                        <DataGridTextColumn Header="Sygnatura" Binding="{Binding Signature}" />
                        <DataGridCheckBoxColumn Header="Aktywna" Binding="{Binding Active, Mode=OneWay}" />
                        <DataGridTextColumn Header="Wersja" Binding="{Binding Version}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding DefinitionFormTitle}" FontWeight="SemiBold" Margin="0,14,0,4" />
                <Grid MaxWidth="720" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Kod źródła" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding DefCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Prefiks pliku" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding DefPrefix, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Początek nazwy pliku, np. ACTUALS_ (wszystkie ACTUALS_…) albo ACTUALS_PAF; wygrywa najdłuższy pasujący prefiks" />
                    <TextBlock Grid.Row="2" Text="Typ raportu" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding DefReportType, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Text="Parser" Style="{StaticResource Label}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" ItemsSource="{Binding ParserOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding DefParser}" />
                    <TextBlock Grid.Row="4" Text="Aktywna" Style="{StaticResource Label}" />
                    <CheckBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DefActive}" />

                </Grid>
                <DockPanel MaxWidth="720" HorizontalAlignment="Left">
                    <Button DockPanel.Dock="Right" Content="Kolumny z pliku…" Style="{StaticResource Btn}" Command="{Binding ColumnsFromFile}"
                            ToolTip="Wczytuje wiersz nagłówków z pliku źródła (pierwszy wiersz pierwszego arkusza – tak samo jak import)" />
                    <TextBlock Text="Oczekiwane kolumny (jedna w wierszu albo wiersz nagłówków wklejony z Excela; kolejność jak w pliku – wyznaczają sygnaturę układu)"
                               Style="{StaticResource Label}" TextWrapping="Wrap" />
                </DockPanel>
                <TextBox Style="{StaticResource Field}" Text="{Binding DefColumns, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                         Height="160" MaxWidth="720" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource FMono}" />
                <TextBlock Text="{Binding DefSignatureText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Zapisz definicję" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Command="{Binding SaveDefinition}" />
                    <Button Content="Usuń definicję" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding DeleteDefinition}"
                            ToolTip="Usuwa wybraną definicję – historia i zaimportowane dane zostają" />
                    <Button Content="Potwierdź usunięcie" Style="{StaticResource Btn}" Command="{Binding ConfirmDeleteDefinition}"
                            Visibility="{Binding DeletePending, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding DefinitionMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left" />

                <TextBlock Text="Historia definicji" FontWeight="SemiBold" Margin="0,14,0,4" />
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding DefinitionHistory}" IsReadOnly="True" MaxHeight="160">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Wersja" Binding="{Binding Version}" />
                        <DataGridTextColumn Header="Zapisano" Binding="{Binding RecordedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                        <DataGridTextColumn Header="Kto" Binding="{Binding RecordedBy}" />
                        <DataGridTextColumn Header="Zamknięta" Binding="{Binding SupersededAt, StringFormat=yyyy-MM-dd HH:mm}" />
                        <DataGridTextColumn Header="Prefiks" Binding="{Binding Prefix}" />
                        <DataGridTextColumn Header="Sygnatura" Binding="{Binding Signature}" />
                        <DataGridCheckBoxColumn Header="Aktywna" Binding="{Binding Active, Mode=OneWay}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Lokalizacje RABIT -->
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Nowa lokalizacja" Style="{StaticResource Btn}" Command="{Binding NewLocation}" />
                    <TextBlock Text="Lokalizacje RABIT" Style="{StaticResource H2}" />
                </DockPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                           Text="Foldery SharePoint czytane przez WebDAV (ścieżka UNC, np. \\serwer@SSL\DavWWWRoot\sites\…). Import czyta też zawsze folder Do_importu środowiska." />
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                          IsReadOnly="True" MaxHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Ścieżka" Binding="{Binding Path}" Width="*" />
                        <DataGridCheckBoxColumn Header="Aktywna" Binding="{Binding Active, Mode=OneWay}" />
                        <DataGridTextColumn Header="Zmieniono" Binding="{Binding RecordedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding LocationFormTitle}" FontWeight="SemiBold" Margin="0,14,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Nazwa" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding LocName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Ścieżka" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding LocPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Ścieżka WebDAV (\\host@SSL\DavWWWRoot\sites\…) albo link do folderu SharePoint z przeglądarki – zostanie zamieniony na ścieżkę WebDAV" />
                    <TextBlock Grid.Row="2" Text="Aktywna" Style="{StaticResource Label}" />
                    <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding LocActive}" />
                </Grid>
                <Button Content="Zapisz lokalizację" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding SaveLocation}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
