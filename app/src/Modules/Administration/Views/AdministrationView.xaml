<UserControl x:Class="PzlEv.Modules.Administration.Views.AdministrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials">
    <UserControl.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,10,4" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <partials:PageHeader Eyebrow="Konfiguracja importu" Title="Administracja"
                             Subtitle="Definicje źródeł (rozpoznanie pliku po prefiksie i parser), parsery (układ kolumn pliku, typy, pola wymagane – tabela danych kanonicznych) i lokalizacje RABIT. Zmiany mają historię." />

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Border Style="{StaticResource Panel}" Margin="0,0,0,12"
                Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Issues}" />
        </Border>

        <!-- Definicje źródeł -->
        <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Nowa definicja" Style="{StaticResource Btn}" Command="{Binding NewDefinition}" />
                    <TextBlock Text="Definicje źródeł" Style="{StaticResource H2}" />
                </DockPanel>
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}"
                          IsReadOnly="True" MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}" />
                        <DataGridTextColumn Header="Prefiks" Binding="{Binding Prefix}" />
                        <DataGridTextColumn Header="Typ raportu" Binding="{Binding ReportType}" Width="*" />
                        <DataGridTextColumn Header="Parser" Binding="{Binding Parser}" />
                        <DataGridCheckBoxColumn Header="Aktywna" Binding="{Binding Active, Mode=OneWay}" />
                        <DataGridTextColumn Header="Wersja" Binding="{Binding Version}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding DefinitionFormTitle}" FontWeight="SemiBold" Margin="0,14,0,4" />
                <Grid MaxWidth="720" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Kod źródła" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding DefCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Prefiks pliku" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding DefPrefix, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Początek nazwy pliku, np. ACTUALS_ (wszystkie ACTUALS_…) albo ACTUALS_PAF; wygrywa najdłuższy pasujący prefiks" />
                    <TextBlock Grid.Row="2" Text="Typ raportu" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding DefReportType, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Text="Parser" Style="{StaticResource Label}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" ItemsSource="{Binding ParserOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding DefParser}"
                              ToolTip="Parser pilnuje układu kolumn pliku, typów i pól wymaganych (sekcja Parsery); „brak” – tylko wiersze surowe" />
                    <TextBlock Grid.Row="4" Text="Aktywna" Style="{StaticResource Label}" />
                    <CheckBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DefActive}" />

                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Zapisz definicję" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Command="{Binding SaveDefinition}" />
                    <Button Content="Usuń definicję" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding DeleteDefinition}"
                            ToolTip="Usuwa wybraną definicję – historia i zaimportowane dane zostają" />
                    <Button Content="Potwierdź usunięcie" Style="{StaticResource Btn}" Command="{Binding ConfirmDeleteDefinition}"
                            Visibility="{Binding DeletePending, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding DefinitionMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left" />

                <TextBlock Text="Historia definicji" FontWeight="SemiBold" Margin="0,14,0,4" />
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding DefinitionHistory}" IsReadOnly="True" MaxHeight="160">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Wersja" Binding="{Binding Version}" />
                        <DataGridTextColumn Header="Zapisano" Binding="{Binding RecordedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                        <DataGridTextColumn Header="Kto" Binding="{Binding RecordedBy}" />
                        <DataGridTextColumn Header="Zamknięta" Binding="{Binding SupersededAt, StringFormat=yyyy-MM-dd HH:mm}" />
                        <DataGridTextColumn Header="Prefiks" Binding="{Binding Prefix}" />
                        <DataGridTextColumn Header="Parser" Binding="{Binding Parser}" />
                        <DataGridCheckBoxColumn Header="Aktywna" Binding="{Binding Active, Mode=OneWay}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Parsery: tabela danych kanonicznych i jej pola -->
        <Border Style="{StaticResource Panel}" Margin="0,0,0,16" DataContext="{Binding ParserEditor}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Nowy parser" Style="{StaticResource Btn}" Command="{Binding NewParser}" />
                    <TextBlock Text="Parsery" Style="{StaticResource H2}" />
                </DockPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                           Text="Parser opisuje układ pliku: każde pole to kolumna w pliku (typ, wymagane) i kolumna tabeli danych kanonicznych CAN_…. Brak kolumny parsera w pliku = błąd importu; kolumny pliku spoza parsera trafiają tylko do wierszy surowych. Nowe pole dokłada kolumnę w tabeli; pola usuniętego z parsera kolumna zostaje (dane zapisane). Zapis zmienia tabele – wymaga prawa tworzenia i zmiany tabel w bazie." />
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Parsers}" SelectedItem="{Binding Selected}"
                          IsReadOnly="True" MaxHeight="160">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}" />
                        <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Tabela" Binding="{Binding Table, Mode=OneWay, StringFormat='CAN_{0}'}" />
                        <DataGridTextColumn Header="Pól" Binding="{Binding Fields.Count, Mode=OneWay}" />
                        <DataGridCheckBoxColumn Header="Aktywny" Binding="{Binding Active, Mode=OneWay}" />
                        <DataGridTextColumn Header="Wersja" Binding="{Binding Version}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" Margin="0,14,0,4" />
                <Grid MaxWidth="720" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Kod parsera" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsNew}" ToolTip="Wielkie litery, cyfry i _ (np. FORECAST); po zapisie nie zmienia się – wyznacza tabelę CAN_…" />
                    <TextBlock Grid.Row="1" Text="Nazwa" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" Text="Aktywny" Style="{StaticResource Label}" />
                    <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding Active}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TableText}" Style="{StaticResource MutedText}" Margin="0,4,0,4" />
                </Grid>

                <DockPanel Margin="0,8,0,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Kolumny z pliku…" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding ColumnsFromFile}"
                                ToolTip="Porównuje parser z wierszem nagłówków przykładowego pliku: nowe kolumny dochodzą jako pola, przy polach – przykłady wartości" />
                        <Button Content="Dodaj pole" Style="{StaticResource Btn}" Command="{Binding AddField}" />
                    </StackPanel>
                    <TextBlock Text="Pola: kolumna w pliku → kolumna w bazie" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Fields}" MaxHeight="360">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Kolumna w pliku" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Column, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                                             ToolTip="Nazwa nagłówka w pliku (bez rozróżniania wielkości liter); pusta – pole nie jest czytane z pliku" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Przykład z pliku" Binding="{Binding Sample, Mode=OneWay}" IsReadOnly="True" MaxWidth="200" />
                        <DataGridTemplateColumn Header="Pole w bazie" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Field, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" FontFamily="{StaticResource FMono}"
                                             ToolTip="Nazwa kolumny w bazie: litera, potem litery, cyfry i _ (np. InvoiceNumber)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Typ" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.TypeOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Margin="0,1" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Długość" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsText}" BorderThickness="0"
                                             ToolTip="Najwięcej znaków tekstu (domyślnie 400)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Zera do" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding PadDigits, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsText}" BorderThickness="0"
                                             ToolTip="Tekst z samych cyfr dopełniany zerami z lewej do tej długości (np. 10 dla numeru elementu kosztowego)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Wymagane" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Required, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasColumn}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="Wartość musi być w każdym wierszu – inaczej plik nie przejdzie walidacji" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Usuń" Style="{StaticResource Btn}" Padding="6,1"
                                            Command="{Binding DataContext.RemoveField, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                            ToolTip="Usuwa pole z parsera – kolumna w bazie i zapisane dane zostają" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="Zapisz parser" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding Save}" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left" />

                <TextBlock Text="Historia parsera" FontWeight="SemiBold" Margin="0,14,0,4" />
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding History}" IsReadOnly="True" MaxHeight="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Wersja" Binding="{Binding Version}" />
                        <DataGridTextColumn Header="Zapisano" Binding="{Binding RecordedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                        <DataGridTextColumn Header="Kto" Binding="{Binding RecordedBy}" />
                        <DataGridTextColumn Header="Pól" Binding="{Binding Fields.Count, Mode=OneWay}" />
                        <DataGridTextColumn Header="Zamknięta" Binding="{Binding SupersededAt, StringFormat=yyyy-MM-dd HH:mm}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Lokalizacje RABIT -->
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Nowa lokalizacja" Style="{StaticResource Btn}" Command="{Binding NewLocation}" />
                    <TextBlock Text="Lokalizacje RABIT" Style="{StaticResource H2}" />
                </DockPanel>
                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                           Text="Foldery SharePoint czytane przez WebDAV (ścieżka UNC, np. \\serwer@SSL\DavWWWRoot\sites\…). Import czyta też zawsze folder Do_importu środowiska." />
                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}"
                          IsReadOnly="True" MaxHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Ścieżka" Binding="{Binding Path}" Width="*" />
                        <DataGridCheckBoxColumn Header="Aktywna" Binding="{Binding Active, Mode=OneWay}" />
                        <DataGridTextColumn Header="Zmieniono" Binding="{Binding RecordedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{Binding LocationFormTitle}" FontWeight="SemiBold" Margin="0,14,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Nazwa" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding LocName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Ścieżka" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding LocPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Ścieżka WebDAV (\\host@SSL\DavWWWRoot\sites\…) albo link do folderu SharePoint z przeglądarki – zostanie zamieniony na ścieżkę WebDAV" />
                    <TextBlock Grid.Row="2" Text="Aktywna" Style="{StaticResource Label}" />
                    <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding LocActive}" />
                </Grid>
                <Button Content="Zapisz lokalizację" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding SaveLocation}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
