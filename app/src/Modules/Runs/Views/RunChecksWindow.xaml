<Window x:Class="PzlEv.Modules.Runs.Views.RunChecksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials"
        Title="Kontrole przebiegu" Width="1180" Height="800" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
    <!-- Okno Kontrole (DataContext: RunChecksViewModel) – katalog kontroli w grupach, reguły uzgodnień; docs/pipeline-fazy.md, rozdz. 4.1 -->
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Kontrole przebiegu" Style="{StaticResource H2}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Możliwe kontrole w grupach i ich ustawienie domyślne (wszystkie programy). Szablon przebiegu wybiera kontrole do etapów walidacji i może zmienić poziom albo próg na kafelku etapu." />
        <partials:BusyBar DockPanel.Dock="Top" DataContext="{Binding Busy}" />

        <TabControl>
            <!-- Katalog kontroli w grupach z ustawieniem domyślnym -->
            <TabItem Header="Katalog kontroli" Padding="12,4">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Zapisz ustawienia" Style="{StaticResource BtnPrimary}" Command="{Binding Save}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Rules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="320" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding Active}" VerticalAlignment="Center" ToolTip="Aktywna – liczona, gdy etap szablonu ją zawiera" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Rule.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Rule.Check}" Style="{StaticResource MutedText}" />
                                                            </StackPanel>
                                                            <ComboBox Grid.Column="2" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" Margin="8,0" VerticalAlignment="Center"
                                                                      AutomationProperties.Name="Poziom" />
                                                            <TextBox Grid.Column="3" Style="{StaticResource Input}" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{Binding HasThreshold}" VerticalAlignment="Center" ToolTip="Próg (kwota albo krotność) – tylko reguły z progiem"
                                                                     AutomationProperties.Name="Próg" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Rule.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="12,0"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="5" Content="Domyślne" Style="{StaticResource Btn}" Padding="8,2" VerticalAlignment="Center"
                                                                    CommandParameter="{Binding}" ToolTip="{Binding CatalogText, StringFormat='Ustawienie katalogu: {0}'}"
                                                                    Command="{Binding DataContext.Reset, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Reguły uzgodnień i ustawienia dla typów: tabela słownika -->
            <TabItem Header="Reguły uzgodnień" Padding="12,4">
                <DockPanel Margin="0,12,0,0" DataContext="{Binding Editor}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Własne kontrole bez zmiany programu: lewa strona, warunek (=, &lt;=, &gt;=, &lt;&gt;), prawa strona i tolerancja; strony to formuły z miar w nawiasach kwadratowych, liczb, + - * / i nawiasów, np. [Koszt brutto] &lt;= [BAC] * 1,1. „Kontrole przebiegu” – ustawienia reguł katalogu dla typu programu (zaawansowane)." />
                        <DockPanel Margin="0,0,0,8">
                            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Dictionaries}" SelectedItem="{Binding Spec}" DisplayMemberPath="Name" Width="220" Margin="0,0,12,0"
                                      AutomationProperties.Name="Słownik" />
                            <Button DockPanel.Dock="Right" Content="Pobierz do Excela" Style="{StaticResource Btn}" Command="{Binding Export}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Dodaj wiersz" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding AddRow}" />
                                <Button Content="Usuń wiersze" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding RemoveRow}" />
                                <Button Content="Cofnij" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Table.Undo}" />
                                <Button Content="Odrzuć zmiany" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Discard}" />
                                <Button Content="Zapisz" Style="{StaticResource BtnPrimary}" Command="{Binding Save}" />
                            </StackPanel>
                        </DockPanel>
                        <partials:BusyBar DataContext="{Binding Busy}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <partials:DictionaryGrid DataContext="{Binding Table}" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Miary do formuł reguł uzgodnień -->
            <TabItem Header="Miary do formuł" Padding="12,4">
                <DataGrid Margin="0,12,0,0" Style="{StaticResource DataTable}" ItemsSource="{Binding Measures}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Miara" Binding="{Binding Name, StringFormat='[{0}]'}" />
                        <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
