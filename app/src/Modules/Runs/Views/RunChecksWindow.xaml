<Window x:Class="PzlEv.Modules.Runs.Views.RunChecksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials"
        Title="Kontrole przebiegu" Width="1400" Height="880" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
    <!-- Okno Kontrole (DataContext: RunChecksViewModel) – katalog kontroli w grupach, reguły uzgodnień; docs/pipeline-fazy.md, rozdz. 4.1 -->
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Kontrole przebiegu" Style="{StaticResource H2}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Walidacja ACTUALS – reguły z formułami na całej puli ACTUALS (przed narzutami, bez Wykluczeń), edytowalne i testowane na programie. Walidacja EV – reguły wbudowane na danych jak w strukturze (bez rozliczeniowych, po Wykluczeniach, CAS po narzutach). Szablon przebiegu wybiera kontrole do etapów i może zmienić poziom albo próg na kafelku etapu." />
        <partials:BusyBar DockPanel.Dock="Top" DataContext="{Binding Busy}" />

        <TabControl>
            <!-- Reguły walidacji ACTUALS: formuły, kontrola składni, test na programie -->
            <TabItem Header="Walidacja ACTUALS – reguły" Padding="12,4">
                <Grid Margin="0,12,0,0" DataContext="{Binding Validations}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <!-- Lista reguł -->
                    <DockPanel Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <WrapPanel>
                                <Button Content="Nowa" Style="{StaticResource Btn}" Margin="0,0,6,6" Command="{Binding Add}" />
                                <Button Content="Kopiuj" Style="{StaticResource Btn}" Margin="0,0,6,6" Command="{Binding Copy}" />
                                <Button Content="Usuń" Style="{StaticResource Btn}" Margin="0,0,6,6" Command="{Binding Remove}" />
                                <Button Content="Przywróć startową" Style="{StaticResource Btn}" Margin="0,0,6,6" Command="{Binding Restore}"
                                        ToolTip="Formuły reguły startowej aplikacji o tej nazwie" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Odrzuć zmiany" Style="{StaticResource Btn}" Margin="0,0,6,0" Command="{Binding Discard}" />
                                <Button Content="Zapisz reguły" Style="{StaticResource BtnPrimary}" Command="{Binding Save}" />
                            </StackPanel>
                            <partials:BusyBar DataContext="{Binding Busy}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Reguły walidacji">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3" Width="220">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource MutedText}">
                                            <Run Text="{Binding Check, Mode=OneWay}" />
                                            <Run Text="{Binding Level, Mode=OneWay, StringFormat='· {0}'}" />
                                        </TextBlock>
                                        <TextBlock Text="błąd składni" Foreground="{StaticResource Crit}" FontSize="11"
                                                   Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Formuły reguły i test -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding Selected}" Visibility="{Binding DataContext.HasSelected, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Nazwa" VerticalAlignment="Center" />
                                <DockPanel Grid.Column="1" Margin="0,0,0,6">
                                    <CheckBox DockPanel.Dock="Right" Content="Aktywna" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="12,0,0,0"
                                              ToolTip="Wyłączona – nie liczy się w żadnym przebiegu" />
                                    <TextBox Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="Kontrola" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                    <ComboBox IsEditable="True" Width="260" Text="{Binding Check, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.Checks, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                              ToolTip="Wiersz macierzy wyników (np. Jakość danych); można wpisać nową kontrolę" />
                                    <TextBlock Text="Poziom" VerticalAlignment="Center" Margin="16,0,6,0" />
                                    <ComboBox Width="110" ItemsSource="{Binding DataContext.Levels, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" SelectedItem="{Binding Level}" />
                                    <TextBlock Text="Próg" VerticalAlignment="Center" Margin="16,0,6,0" />
                                    <TextBox Style="{StaticResource Input}" Width="90" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" ToolTip="Wartość [Próg] w formułach" />
                                    <TextBlock Text="Najwyżej" VerticalAlignment="Center" Margin="16,0,6,0" />
                                    <TextBox Style="{StaticResource Input}" Width="60" Text="{Binding Top, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Najwyżej N wyników, od największej |kwoty| (0 – wszystkie)" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="Filtr" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Input}" FontFamily="{StaticResource FMono}" Margin="0,0,0,6"
                                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32"
                                         ToolTip="Warunek na pojedynczym wierszu, np. [Okres zamknięty] ORAZ NIE [Rozliczeniowy]; puste – wszystkie wiersze" />
                                <TextBlock Grid.Row="3" Text="Grupuj" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Input}" FontFamily="{StaticResource FMono}" Margin="0,0,0,6"
                                         Text="{Binding GroupBy, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Pola wiersza po średniku, np. [Element WBS]; [Rok/okres]; puste – cały program jako jedna grupa" />
                                <TextBlock Grid.Row="4" Text="Warunek" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Input}" FontFamily="{StaticResource FMono}" Margin="0,0,0,6"
                                         Text="{Binding Condition, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32"
                                         ToolTip="Kiedy grupa jest wynikiem, np. ABS(SUMA([Kwota]) - POPRZ.SUMA([Kwota])) > [Próg]" />
                                <TextBlock Grid.Row="5" Text="Kwota" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource Input}" FontFamily="{StaticResource FMono}" Margin="0,0,0,6"
                                         Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" ToolTip="Kwota wyniku (kolumna Kwota, kolejność wyników); puste – bez kwoty" />
                                <TextBlock Grid.Row="6" Text="Komunikat" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource Input}" FontFamily="{StaticResource FMono}" Margin="0,0,0,6"
                                         Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                         ToolTip="Tekst wyniku z wyrażeniami w nawiasach klamrowych, np. Element {[Element WBS]}: saldo {SUMA([Kwota])}" />
                                <TextBlock Grid.Row="7" Text="Komunikat OK" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource Input}" FontFamily="{StaticResource FMono}" Margin="0,0,0,6"
                                         Text="{Binding OkMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32"
                                         ToolTip="Wynik INFO, gdy żadna grupa nie spełnia warunku (cały program po filtrze); puste – bez wyniku" />
                                <TextBlock Grid.Row="8" Text="Opis" VerticalAlignment="Center" />
                                <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource Input}" Margin="0,0,0,6" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Errors}" Foreground="{StaticResource Crit}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </Grid>

                            <!-- Test reguły -->
                            <Border Style="{StaticResource Panel}" Margin="0,12,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Testuj na programie" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                                        <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}" DisplayMemberPath="Code" Width="160" Margin="0,0,8,0" />
                                        <Button Content="Testuj" Style="{StaticResource BtnPrimary}" Command="{Binding Test}"
                                                ToolTip="Liczy zaznaczoną regułę (także niezapisaną) na ostatnim uruchomieniu programu i poprzednim – bez zapisu wyników" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TestNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Results}" IsReadOnly="True" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Poziom" Binding="{Binding Level}" />
                                            <DataGridTextColumn Header="Element" Binding="{Binding Element}" />
                                            <DataGridTextColumn Header="Kwota" Binding="{Binding Amount, StringFormat=#\,0.00}" />
                                            <DataGridTextColumn Header="Komunikat" Binding="{Binding Message}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pola i funkcje języka reguł -->
                    <DockPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Pola i funkcje" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,4" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Pola w [ ], teksty w &quot; &quot;, argumenty po średniku, liczby z przecinkiem. W warunku, kwocie i komunikacie pola spoza grupowania tylko w agregatach." />
                        <ListBox ItemsSource="{Binding Terms}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock FontFamily="{StaticResource FMono}" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="{Binding Kind, Mode=OneWay, StringFormat=' ({0})'}" Foreground="{StaticResource Muted}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Walidacja EV: reguły wbudowane w grupach z ustawieniem domyślnym -->
            <TabItem Header="Walidacja EV – reguły wbudowane" Padding="12,4">
                <DockPanel Margin="0,12,0,0">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="Zapisz ustawienia" Style="{StaticResource BtnPrimary}" Command="{Binding Save}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Rules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="320" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding Active}" VerticalAlignment="Center" ToolTip="Aktywna – liczona, gdy etap szablonu ją zawiera" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Rule.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Rule.Check}" Style="{StaticResource MutedText}" />
                                                            </StackPanel>
                                                            <ComboBox Grid.Column="2" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" Margin="8,0" VerticalAlignment="Center"
                                                                      AutomationProperties.Name="Poziom" />
                                                            <TextBox Grid.Column="3" Style="{StaticResource Input}" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{Binding HasThreshold}" VerticalAlignment="Center" ToolTip="Próg (kwota albo krotność) – tylko reguły z progiem"
                                                                     AutomationProperties.Name="Próg" />
                                                            <TextBlock Grid.Column="4" Text="{Binding Rule.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="12,0"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="5" Content="Domyślne" Style="{StaticResource Btn}" Padding="8,2" VerticalAlignment="Center"
                                                                    CommandParameter="{Binding}" ToolTip="{Binding CatalogText, StringFormat='Ustawienie katalogu: {0}'}"
                                                                    Command="{Binding DataContext.Reset, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Reguły uzgodnień i ustawienia dla typów: tabela słownika -->
            <TabItem Header="Reguły uzgodnień" Padding="12,4">
                <DockPanel Margin="0,12,0,0" DataContext="{Binding Editor}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Własne kontrole bez zmiany programu: lewa strona, warunek (=, &lt;=, &gt;=, &lt;&gt;), prawa strona i tolerancja; strony to formuły z miar w nawiasach kwadratowych, liczb, + - * / i nawiasów, np. [Koszt brutto] &lt;= [BAC] * 1,1. „Kontrole przebiegu” – ustawienia reguł katalogu dla typu programu (zaawansowane)." />
                        <DockPanel Margin="0,0,0,8">
                            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Dictionaries}" SelectedItem="{Binding Spec}" DisplayMemberPath="Name" Width="220" Margin="0,0,12,0"
                                      AutomationProperties.Name="Słownik" />
                            <Button DockPanel.Dock="Right" Content="Pobierz do Excela" Style="{StaticResource Btn}" Command="{Binding Export}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Dodaj wiersz" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding AddRow}" />
                                <Button Content="Usuń wiersze" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding RemoveRow}" />
                                <Button Content="Cofnij" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Table.Undo}" />
                                <Button Content="Odrzuć zmiany" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Discard}" />
                                <Button Content="Zapisz" Style="{StaticResource BtnPrimary}" Command="{Binding Save}" />
                            </StackPanel>
                        </DockPanel>
                        <partials:BusyBar DataContext="{Binding Busy}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <partials:DictionaryGrid DataContext="{Binding Table}" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Miary do formuł reguł uzgodnień -->
            <TabItem Header="Miary reguł uzgodnień" Padding="12,4">
                <DataGrid Margin="0,12,0,0" Style="{StaticResource DataTable}" ItemsSource="{Binding Measures}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Miara" Binding="{Binding Name, StringFormat='[{0}]'}" />
                        <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
