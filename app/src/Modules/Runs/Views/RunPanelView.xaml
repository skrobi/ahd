<UserControl x:Class="PzlEv.Modules.Runs.Views.RunPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials">

    <!-- Przebieg programu (DataContext: RunPanelViewModel) – etapy uruchomienia, bramki, potwierdzenie; docs/pipeline-fazy.md, rozdz. 1.1–1.2. -->
    <UserControl.Resources>
        <!-- Komórka macierzy: kolor według najgorszego poziomu wyniku kontroli w uruchomieniu. -->
        <Style x:Key="MatrixCell" TargetType="Button">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Pass">
                    <Setter Property="Background" Value="{StaticResource OkSoft}" />
                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource WarnSoft}" />
                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource CritSoft}" />
                    <Setter Property="Foreground" Value="{StaticResource Crit}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Znacznik statusu etapu: kolor wg statusu (RunStepStatuses). -->
        <Style x:Key="StepStatus" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Row.Status}" Value="Zakończony">
                    <Setter Property="Background" Value="{StaticResource OkSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Row.Status}" Value="Wymaga akcji">
                    <Setter Property="Background" Value="{StaticResource WarnSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Row.Status}" Value="Błąd">
                    <Setter Property="Background" Value="{StaticResource CritSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Row.Status}" Value="W toku">
                    <Setter Property="Background" Value="{StaticResource InfoSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Row.Status}" Value="Nieaktualny">
                    <Setter Property="Background" Value="{StaticResource StaleSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Nowy przebieg" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Command="{Binding NewRun}"
                        ToolTip="Nowe uruchomienie wg definicji przebiegu programu – etapy wykonują się automatycznie do pierwszej bramki" />
                <Button Content="Dalsze etapy" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Continue}"
                        ToolTip="Wykonaj kolejne etapy ostatniego uruchomienia do najbliższej bramki" />
                <Button Content="Zmiany ACWP" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding OpenAcwpChanges}"
                        ToolTip="Co doszło albo się zmieniło w ACWP Hours / Materials / Other – dwa uruchomienia albo okres do okresu, drzewo zmian, linie źródłowe" />
                <Button Content="Odśwież" Style="{StaticResource Btn}" Command="{Binding Refresh}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Uruchomienie" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Pins}" SelectedItem="{Binding SelectedPin}" Width="340" AutomationProperties.Name="Uruchomienie">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding PinNo, Mode=OneWay, StringFormat='#{0}'}" />
                                <Run Text="{Binding Status, Mode=OneWay, StringFormat='– {0}'}" Foreground="{StaticResource Muted}" />
                                <Run Text="{Binding ClosingText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </DockPanel>
        <TextBlock partials:CopyText.Enabled="True" Text="{Binding Assigned}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
        <partials:BusyBar DataContext="{Binding Busy}" />
        <Border Background="{StaticResource CritSoft}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock partials:CopyText.Enabled="True" Text="{Binding Error}" Foreground="{StaticResource Crit}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>
        <!-- Przebieg w toku: etap, reguła i czas od uruchomienia (licznik co sekundę), pasek – jak BusyBar -->
        <Border Background="{StaticResource InfoSoft}" BorderBrush="{StaticResource Info}" BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,8" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock partials:CopyText.Enabled="True" Text="{Binding ProgressText}" Foreground="{StaticResource Info}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,6,0,0" BorderThickness="0"
                             Foreground="{StaticResource Info}" Background="{StaticResource Surface}" />
            </StackPanel>
        </Border>
        <!-- Zmiany po przypięciu (docs/pipeline-fazy.md, rozdz. 5) – tylko informacja -->
        <Border Background="{StaticResource WarnSoft}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                Visibility="{Binding HasPinChanges, Converter={StaticResource BoolToVisibility}}">
            <TextBlock partials:CopyText.Enabled="True" Text="{Binding PinChanges}" TextWrapping="Wrap" />
        </Border>
        <TextBlock partials:CopyText.Enabled="True" Text="{Binding Notice}" Style="{StaticResource MutedText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock partials:CopyText.Enabled="True" Text="{Binding Definition}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Style="{StaticResource MutedText}" Text="Brak uruchomień przebiegu programu – „Nowy przebieg”." TextWrapping="Wrap"
                   Visibility="{Binding NoRuns, Converter={StaticResource BoolToVisibility}}" />

        <TabControl>
            <!-- Etapy wybranego uruchomienia: status, bramka, potwierdzenie, ponowne wykonanie, wyniki etapu -->
            <TabItem Header="Etapy" Padding="12,4">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Etapy uruchomienia – poziomy pasek kafelków (cała szerokość dla wyników) -->
                    <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Etapy przebiegu">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,8,2" Width="230">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource StepStatus}">
                                            <TextBlock Text="{Binding Row.Status}" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                    </DockPanel>
                                    <TextBlock partials:CopyText.Enabled="True" Text="{Binding Results}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding When}" Style="{StaticResource MutedText}" />
                                    <TextBlock partials:CopyText.Enabled="True" Text="{Binding Row.Comment}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,2,0,0"
                                               Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Wybrany etap: bramka, akcje, wyniki -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="{Binding SelectedStep.Title}" Style="{StaticResource H2}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                            <Run Text="{Binding SelectedStep.Row.Action, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding SelectedStep.Gate, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock partials:CopyText.Enabled="True" Text="{Binding SelectedStep.Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />

                        <DockPanel Margin="0,10,0,10">
                            <Button DockPanel.Dock="Right" Content="Wykonaj ponownie" Style="{StaticResource Btn}" Margin="8,0,0,0" Command="{Binding Rerun}"
                                    ToolTip="Ponowne wykonanie etapu (np. po poprawie danych lub słowników); późniejsze etapy stają się nieaktualne" />
                            <Button DockPanel.Dock="Right" Content="{Binding SelectedStep.ConfirmText, FallbackValue='Potwierdź i dalej'}" Style="{StaticResource BtnPrimary}"
                                    Margin="8,0,0,0" Command="{Binding Confirm}"
                                    ToolTip="Etap wymagający akcji albo zatrzymany na błędzie: potwierdzenie ostrzeżeń / akceptacja błędów / zatwierdzenie z komentarzem (etap, dziennik), potem kolejne etapy" />
                            <TextBox Style="{StaticResource Input}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Komentarz potwierdzenia" ToolTip="Komentarz potwierdzenia etapu (wymagany)" />
                        </DockPanel>

                        <!-- Etap „Powiadomienie CAM”: wysłane powiadomienia w cyklu, ponowna wysyłka -->
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10" DataContext="{Binding CamNotify}"
                                Visibility="{Binding DataContext.IsCamNotifyStep, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Wyślij ponownie" Style="{StaticResource Btn}" Command="{Binding Resend}"
                                            ToolTip="E-mail do wszystkich CAM-ów z zaległymi estymacjami programu w cyklu – także powiadomionych wcześniej" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <partials:BusyBar DataContext="{Binding Busy}" />
                                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Rows}" IsReadOnly="True" MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Kiedy, kto" Binding="{Binding When}" />
                                        <DataGridTextColumn Header="CAM" Binding="{Binding Cam}" />
                                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" />
                                        <DataGridTemplateColumn Header="Wynik">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Result}" FontWeight="SemiBold"
                                                               Foreground="{Binding Tone, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="WP" Binding="{Binding Wps}" Width="*" MinWidth="160" />
                                        <DataGridTextColumn Header="Błąd" Binding="{Binding Message}" Width="*" MinWidth="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock partials:CopyText.Enabled="True" Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Etap „Estymacje CAM”: liczniki wymaganych WP, lista estymacji programu w cyklu, decyzje finansisty -->
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,10" DataContext="{Binding CamReview}"
                                Visibility="{Binding DataContext.IsCamStep, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Odśwież" Style="{StaticResource Btn}" Command="{Binding Refresh}" />
                                    <CheckBox DockPanel.Dock="Right" Content="Tylko wymagane" IsChecked="{Binding OnlyRequired}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <Border Style="{StaticResource Tag}" Margin="0,0,8,4"><TextBlock><Run Text="Wymagane: " /><Run Text="{Binding RequiredText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource OkSoft}" Margin="0,0,8,4"><TextBlock><Run Text="Zatwierdzone: " /><Run Text="{Binding ApprovedText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource InfoSoft}" Margin="0,0,8,4"><TextBlock><Run Text="Do decyzji (wysłane): " /><Run Text="{Binding SentText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource CritSoft}" Margin="0,0,8,4"><TextBlock><Run Text="U CAM-a (szkic, zwrócone): " /><Run Text="{Binding AtCamText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                                    <Border Style="{StaticResource Tag}" Background="{StaticResource WarnSoft}" Margin="0,0,8,4"><TextBlock><Run Text="Brak: " /><Run Text="{Binding MissingText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock></Border>
                                </WrapPanel>
                                <partials:BusyBar DataContext="{Binding Busy}" />
                                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" MaxHeight="360">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Status">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Tone, Converter={StaticResource LevelBrush}, ConverterParameter=bg}" CornerRadius="10" Padding="8,1" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Medium"
                                                                   Foreground="{Binding Tone, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="WP" Binding="{Binding Wp}" />
                                        <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*" MinWidth="140" />
                                        <DataGridTextColumn Header="CAM" Binding="{Binding Cam}" />
                                        <DataGridTextColumn Header="Wymagana" Binding="{Binding Required}" />
                                        <DataGridTextColumn Header="ETC godziny" Binding="{Binding EtcHours}" />
                                        <DataGridTextColumn Header="ETC materiały" Binding="{Binding Material}" />
                                        <DataGridTextColumn Header="Koniec (Forecast)" Binding="{Binding Finish}" />
                                        <DataGridTextColumn Header="Uzasadnienie / uwaga" Binding="{Binding Note}" Width="2*" MinWidth="160" />
                                        <DataGridTextColumn Header="Wysłana" Binding="{Binding Submitted}" />
                                        <DataGridTextColumn Header="Oceniona" Binding="{Binding Reviewed}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding Editable, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Uwaga przy zwrocie albo powód ponownego otwarcia (min. 10 znaków)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource Input}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Zatwierdź estymację" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Command="{Binding Approve}"
                                                ToolTip="Wysłana estymacja WP – zapis ETC HOURS, ETC MATERIAL, Forecast Start / Koniec w „Harmonogram i budżet”" />
                                        <Button Content="Zwróć do CAM-a" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Return}" />
                                        <Button Content="Otwórz ponownie" Style="{StaticResource Btn}" Command="{Binding Reopen}"
                                                ToolTip="Zatwierdzona estymacja wraca do CAM-a jako zwrócona z komentarzem; „Harmonogram i budżet” bez zmian do ponownego zatwierdzenia" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="Decyzje – w ostatnim uruchomieniu, gdy etap czeka na akceptację." Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                           Visibility="{Binding ReadOnly, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock partials:CopyText.Enabled="True" Text="{Binding Message}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Wyniki etapu po regułach; wybrana reguła: kontekst, wynik zapytania z problemem, linie ACTUALS wiersza -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListBox ItemsSource="{Binding RuleResults}" SelectedItem="{Binding SelectedRuleResult}" MaxHeight="620" VerticalAlignment="Top"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Reguły etapu">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3" Width="260">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding LevelText}" Width="62" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding Tone, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Popraw w aplikacji" Style="{StaticResource Btn}" Margin="8,0,0,0" CommandParameter="{Binding SelectedIssue}"
                                                Command="{Binding Fix}" Visibility="{Binding SelectedIssue.CanFix, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                                ToolTip="Słownik do poprawy z filtrem na zaznaczony wiersz (kolumny Slownik i Filtr reguły); po poprawie – „Wykonaj ponownie” etap" />
                                        <Button Content="Pokaż zmiany" Style="{StaticResource Btn}" Margin="8,0,0,0" CommandParameter="{Binding SelectedIssue}"
                                                Command="{Binding ShowChanges}" IsEnabled="{Binding SelectedIssue.CanShowChanges}"
                                                ToolTip="Okno „Zmiany ACWP” dla zaznaczonego wiersza" />
                                        <Button Content="Wynik do Excela" Style="{StaticResource Btn}" Margin="8,0,0,0" Command="{Binding ExportResult}"
                                                ToolTip="Wynik reguły i wszystkie linie ACTUALS zaznaczonego wiersza" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedRuleResult.Name}" Style="{StaticResource H2}" FontSize="15" TextWrapping="Wrap" />
                                </DockPanel>
                                <!-- Co sprawdza reguła; dane i zakres uruchomienia – w podpowiedzi -->
                                <Border Background="{StaticResource Surface2}" CornerRadius="6" Padding="10,6" Margin="0,0,0,8" ToolTip="{Binding RuleDataTip}">
                                    <TextBlock partials:CopyText.Enabled="True" Text="{Binding RuleContext}" TextWrapping="Wrap" />
                                </Border>
                                <!-- Wynik: kolumny zapytania (kwoty do prawej), potem Problem; wskazówka pod tabelą -->
                                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding ResultView}" SelectedItem="{Binding SelectedResultRow}"
                                          AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="360" AutomationProperties.Name="Wynik reguły"
                                          AutoGeneratingColumn="OnResultColumn" />
                                <TextBlock partials:CopyText.Enabled="True" Text="{Binding ResultHint}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" />
                                <TextBlock partials:CopyText.Enabled="True" Text="{Binding LinesTitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,4" />
                                <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Lines}" IsReadOnly="True" MaxHeight="360" AutomationProperties.Name="Linie ACTUALS">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Rok/okres" Binding="{Binding Period}" />
                                        <DataGridTextColumn Header="Element WBS" Binding="{Binding Line.WbsElement}" />
                                        <DataGridTextColumn Header="Cost element" Binding="{Binding Line.CostElement}" />
                                        <DataGridTextColumn Header="Created on" Binding="{Binding Line.CreatedOn}" />
                                        <DataGridTextColumn Header="Opis" Binding="{Binding Line.CoObjectName}" />
                                        <DataGridTextColumn Header="Partner" Binding="{Binding Line.PartnerObject}" />
                                        <DataGridTextColumn Header="Zamówienie" Binding="{Binding Line.PurchaseOrderNumber}" />
                                        <DataGridTextColumn Header="Faktura" Binding="{Binding Line.InvoiceNumber}" />
                                        <DataGridTextColumn Header="Zlecenie" Binding="{Binding Line.OriginalOrderNumber}" />
                                        <DataGridTextColumn Header="Ilość" Binding="{Binding Line.Quantity, StringFormat=#\,0.###}" />
                                        <DataGridTextColumn Header="Kwota" Binding="{Binding Line.Amount, StringFormat=#\,0.00}" />
                                        <DataGridTextColumn Header="Plik" Binding="{Binding Line.FileName}" />
                                        <DataGridTextColumn Header="Wiersz" Binding="{Binding Line.RowNumber}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Macierz kontrola × ostatnie uruchomienia; klik w komórkę – wyniki kontroli w uruchomieniu -->
            <TabItem Header="Reguły – macierz" Padding="12,4">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource MutedText}" Text="Brak zakończonych uruchomień przebiegu programu." TextWrapping="Wrap"
                               Visibility="{Binding NoRuns, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Nagłówek: uruchomienia od najstarszego -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Width="260" Text="Reguła / kontrola" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" />
                                <ItemsControl ItemsSource="{Binding Matrix.Columns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Width="132" Text="{Binding Label}" ToolTip="{Binding Detail}" FontWeight="SemiBold"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Matrix.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Width="260" Text="{Binding CheckName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CheckName}" />
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource MatrixCell}" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.SelectCell, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                ToolTip="Wyniki kontroli w tym uruchomieniu" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Text="{Binding CellTitle}" Style="{StaticResource H2}" Margin="0,16,0,6" TextWrapping="Wrap" />
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding CellIssues}" IsReadOnly="True" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Poziom" Binding="{Binding LevelText}" />
                            <DataGridTextColumn Header="Element" Binding="{Binding Issue.Element}" />
                            <DataGridTextColumn Header="Opis" Binding="{Binding Issue.Message}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Pokaż zmiany" Style="{StaticResource Btn}" Padding="8,2" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.ShowChanges, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding CanShowChanges, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Okno „Zmiany ACWP” dla tego wyniku: rodzaj kosztu, cost element albo element WBS; to uruchomienie i poprzednie" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <!-- Porównanie dwóch uruchomień: nowe, zmienione, rozwiązane wyniki kontroli -->
            <TabItem Header="Porównanie uruchomień" Padding="12,4">
                <StackPanel Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Było" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ComparePins}" SelectedItem="{Binding BeforePin}" Width="300" AutomationProperties.Name="Uruchomienie było">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding PinNo, Mode=OneWay, StringFormat='#{0}'}" />
                                        <Run Text="{Binding Status, Mode=OneWay, StringFormat='– {0}'}" Foreground="{StaticResource Muted}" />
                                        <Run Text="{Binding ClosingText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="⇄" Style="{StaticResource Btn}" Margin="6,0" Command="{Binding SwapCompare}" ToolTip="Zamień uruchomienia" />
                        <TextBlock Text="Jest" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ComparePins}" SelectedItem="{Binding AfterPin}" Width="300" Margin="0,0,16,0" AutomationProperties.Name="Uruchomienie jest">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding PinNo, Mode=OneWay, StringFormat='#{0}'}" />
                                        <Run Text="{Binding Status, Mode=OneWay, StringFormat='– {0}'}" Foreground="{StaticResource Muted}" />
                                        <Run Text="{Binding ClosingText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox Content="Tylko zamknięcia okresów" IsChecked="{Binding OnlyClosings}" VerticalAlignment="Center" Margin="0,0,16,0"
                                  ToolTip="Do wyboru tylko zamknięcia okresów (★ – ostatnie zakończone uruchomienie tygodnia zamykającego z kalendarza okresów); wybór: dwa ostatnie zamknięcia" />
                        <CheckBox Content="Tylko zmiany" IsChecked="{Binding OnlyChanges}" VerticalAlignment="Center"
                                  ToolTip="Nowe, zmienione (poziom, liczba wierszy, wartości kolumn liczbowych) i rozwiązane wyniki reguł; bez wyników bez zmian" />
                    </StackPanel>
                    <TextBlock partials:CopyText.Enabled="True" Text="{Binding CompareNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Compare}" IsReadOnly="True" MaxHeight="560">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zmiana" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="Reguła / kontrola" Binding="{Binding CheckName}" />
                            <DataGridTextColumn Header="Wiersz (kolumny tekstowe)" Binding="{Binding Element}" />
                            <DataGridTextColumn Header="Było" Binding="{Binding LevelBefore}" />
                            <DataGridTextColumn Header="Jest" Binding="{Binding LevelAfter}" />
                            <DataGridTextColumn Header="Różnice (kolumny liczbowe)" Binding="{Binding Changes}" MaxWidth="360">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Opis" Binding="{Binding Message}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Pokaż zmiany" Style="{StaticResource Btn}" Padding="8,2" CommandParameter="{Binding Issue}"
                                                Command="{Binding DataContext.ShowChanges, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding Issue.CanShowChanges, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Okno „Zmiany ACWP” dla tego wyniku" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
