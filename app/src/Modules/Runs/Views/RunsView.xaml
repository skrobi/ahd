<UserControl x:Class="PzlEv.Modules.Runs.Views.RunsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:partials="clr-namespace:PzlEv.Shared.Views.Partials"
             xmlns:views="clr-namespace:PzlEv.Modules.Runs.Views">

    <!-- Ekran Przebiegi (DataContext: RunsViewModel) – docs/funkcjonalnosc.md, F06; reguły kontroli – docs/pipeline-fazy.md, rozdz. 4.1. -->
    <UserControl.Resources>
        <!-- Komórka macierzy: kolor według najgorszego poziomu wyniku kontroli w uruchomieniu. -->
        <Style x:Key="MatrixCell" TargetType="Button">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Pass">
                    <Setter Property="Background" Value="{StaticResource OkSoft}" />
                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource WarnSoft}" />
                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource CritSoft}" />
                    <Setter Property="Foreground" Value="{StaticResource Crit}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <partials:PageHeader Title="Przebiegi" Subtitle="Przebieg programu etap po etapie (bramki, potwierdzenia), przegląd programów, wyniki kontroli, definicje przebiegów i reguły.">
            <partials:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Width="260" Margin="0,0,8,0"
                              AutomationProperties.Name="Program">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="{Binding ProjectType, Mode=OneWay, StringFormat=({0})}" Foreground="{StaticResource Muted}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Zmiany ACWP" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding OpenAcwpChanges}"
                            ToolTip="Co doszło albo się zmieniło w ACWP Hours / Materials / Other – dwa uruchomienia albo okres do okresu, drzewo zmian, linie źródłowe" />
                    <Button Content="Odśwież" Style="{StaticResource Btn}" Command="{Binding Refresh}" />
                </StackPanel>
            </partials:PageHeader.Actions>
        </partials:PageHeader>
        <partials:BusyBar DataContext="{Binding Busy}" />
        <Border Background="{StaticResource CritSoft}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Crit}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Border>

        <TabControl SelectedIndex="{Binding SelectedTab}">
            <!-- Przebieg wybranego programu: etapy, bramki, potwierdzenie z komentarzem, ponowne wykonanie -->
            <TabItem Header="Przebieg" Padding="12,4">
                <views:RunPanelView DataContext="{Binding Panel}" Margin="0,12,0,0" />
            </TabItem>

            <!-- Wszystkie programy: ostatnie uruchomienie i etap, na którym stoi -->
            <TabItem Header="Wszystkie programy" Padding="12,4">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Ostatnie uruchomienie przebiegu każdego programu i etap, na którym przebieg stoi. „Otwórz” – przebieg programu." />
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Programs}" IsReadOnly="True" MaxHeight="640">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Otwórz" Style="{StaticResource Btn}" Padding="8,2" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.OpenProgram, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Program" Binding="{Binding Code}" />
                            <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding ProjectType}" />
                            <DataGridTextColumn Header="Uruchomienie" Binding="{Binding Run}" />
                            <DataGridTextColumn Header="Stan" Binding="{Binding Status}" />
                            <DataGridTextColumn Header="Etap" Binding="{Binding Stop}" Width="*" />
                            <DataGridTextColumn Header="Błędy" Binding="{Binding Errors}" />
                            <DataGridTextColumn Header="Ostrz." Binding="{Binding Warnings}" />
                            <DataGridTextColumn Header="Start" Binding="{Binding StartedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                            <DataGridTextColumn Header="Kto" Binding="{Binding StartedBy}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <!-- Macierz kontrola × uruchomienia; klik w komórkę – wyniki kontroli w uruchomieniu poniżej -->
            <TabItem Header="Kontrole" Padding="12,4">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource MutedText}" Text="Brak uruchomień przebiegu programu – „Nowy przebieg” w zakładce Przebieg albo „Uruchom przebieg” na ekranie programu." TextWrapping="Wrap"
                               Visibility="{Binding NoRuns, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Nagłówek: uruchomienia od najstarszego -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Width="260" Text="Kontrola" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" />
                                <ItemsControl ItemsSource="{Binding Matrix.Columns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Width="132" Text="{Binding Label}" ToolTip="{Binding Detail}" FontWeight="SemiBold"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Matrix.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Width="260" Text="{Binding CheckName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CheckName}" />
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource MatrixCell}" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.SelectCell, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                ToolTip="Wyniki kontroli w tym uruchomieniu" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Text="{Binding CellTitle}" Style="{StaticResource H2}" Margin="0,16,0,6" TextWrapping="Wrap" />
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding CellIssues}" IsReadOnly="True" MaxHeight="480">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Poziom" Binding="{Binding Issue.Level}" />
                            <DataGridTextColumn Header="Element" Binding="{Binding Issue.Element}" />
                            <DataGridTextColumn Header="Opis" Binding="{Binding Issue.Message}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Kwota" Binding="{Binding Issue.Amount, StringFormat=#\,0.00}" />
                            <DataGridTemplateColumn Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Pokaż zmiany" Style="{StaticResource Btn}" Padding="8,2" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.ShowChanges, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Visibility="{Binding CanShowChanges, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Okno „Zmiany ACWP” dla tego wyniku: rodzaj kosztu, cost element albo element WBS; to uruchomienie i poprzednie" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <!-- Definicja przebiegu programu: etapy i elementy kontrolne z ustawieniami; reguły uzgodnień i miary -->
            <TabItem Header="Definicja przebiegu" Padding="12,4">
                <StackPanel Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton Content="W środku okresu" IsChecked="True" Margin="0,0,16,0" />
                        <RadioButton Content="Zamykający okres" IsChecked="{Binding ShowClosing}" />
                    </StackPanel>
                    <TextBlock Text="{Binding WorkflowNote}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Zmiana: zakładka „Definicje i reguły” – definicja (typ programu albo program, wariant przebiegu), etapy (akcja, bramka WARNING, zatwierdzenie) i elementy kontrolne etapów. Puste poziom i próg elementu – ustawienie ze słownika „Kontrole przebiegu”, a bez wiersza – domyślne reguły." />
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Workflow}" IsReadOnly="True" MaxHeight="640">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nr" Binding="{Binding StepNo}" />
                            <DataGridTextColumn Header="Etap" Binding="{Binding Step}" />
                            <DataGridTextColumn Header="Akcja" Binding="{Binding Action}" />
                            <DataGridTextColumn Header="Bramka" Binding="{Binding Gate}" />
                            <DataGridTextColumn Header="Element kontrolny" Binding="{Binding Element}" />
                            <DataGridTextColumn Header="Ustawienie" Binding="{Binding Setting}" />
                            <DataGridTextColumn Header="Źródło" Binding="{Binding Source}" />
                            <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Reguły uzgodnień – własne kontrole ze słownika i miary do formuł -->
                    <TextBlock Text="Reguły uzgodnień typu programu" Style="{StaticResource H2}" Margin="0,20,0,4" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Własne kontrole bez zmiany programu (słownik „Reguły uzgodnień” w zakładce „Definicje i reguły”): lewa strona, warunek (=, &lt;=, &gt;=, &lt;&gt;), prawa strona i tolerancja; strony to formuły z miar w nawiasach kwadratowych, liczb, + - * / i nawiasów, np. [Koszt brutto] &lt;= [BAC] * 1,1. W etapie – element „Uzgodnienie: nazwa” albo „Uzgodnienie: *” (wszystkie aktywne)." />
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Reconciliations}" IsReadOnly="True" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Przebieg" Binding="{Binding RunKind}" />
                            <DataGridTextColumn Header="Warunek" Binding="{Binding Condition}" Width="*" />
                            <DataGridTextColumn Header="Poziom" Binding="{Binding Level}" />
                            <DataGridTextColumn Header="Stan" Binding="{Binding State}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Miary do formuł" Style="{StaticResource H2}" Margin="0,20,0,6" />
                    <DataGrid Style="{StaticResource DataTable}" ItemsSource="{Binding Measures}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Miara" Binding="{Binding Name, StringFormat='[{0}]'}" />
                            <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <!-- Definicje i reguły: słowniki przebiegu (ta sama tabela słownika co w Słownikach – historia, walidacja, Excel) -->
            <TabItem Header="Definicje i reguły" Padding="12,4">
                <Grid Margin="0,12,0,0" DataContext="{Binding Editor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <Border Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="8">
                            <ListBox ItemsSource="{Binding Dictionaries}" SelectedItem="{Binding Spec}" DisplayMemberPath="Name"
                                     BorderThickness="0" Background="Transparent" AutomationProperties.Name="Słowniki przebiegu" />
                        </Border>
                        <Button Content="Kopia definicji wbudowanej" Style="{StaticResource Btn}" HorizontalAlignment="Stretch" Margin="0,10,0,0"
                                Command="{Binding CopyBuiltIn}"
                                ToolTip="Zapisuje definicję wbudowaną (etapy i elementy) jako nową, nieaktywną definicję do dostosowania" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Definicja = typ programu (albo program) i wariant przebiegu; etapy w kolejności (akcja: import, przypięcie, kontrole, zatwierdzenie; bramka WARNING: potwierdzenie albo informacja); elementy kontrolne etapu – reguły kontroli i reguły uzgodnień." />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Spec.Name}" Style="{StaticResource H2}" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Pobierz do Excela" Style="{StaticResource Btn}" Command="{Binding Export}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Dodaj wiersz" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding AddRow}" />
                                <Button Content="Usuń wiersze" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding RemoveRow}" ToolTip="Usuwa wiersze zaznaczonych komórek (Ctrl+minus)" />
                                <Button Content="Cofnij" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Table.Undo}" ToolTip="Cofa ostatnią zmianę w tabeli (Ctrl+Z)" />
                                <Button Content="Odrzuć zmiany" Style="{StaticResource Btn}" Margin="0,0,8,0" Command="{Binding Discard}" />
                                <Button Content="Zapisz" Style="{StaticResource BtnPrimary}" Command="{Binding Save}" />
                                <TextBlock Text="Filtr" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{StaticResource Muted}" />
                                <TextBox Width="180" Style="{StaticResource Input}" Text="{Binding Table.Filter, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DockPanel>
                        <partials:BusyBar DataContext="{Binding Busy}" />
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <partials:DictionaryGrid DataContext="{Binding Table}" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
