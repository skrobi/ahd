<?xml version="1.0" encoding="utf-8"?>
<!--
  Źródło pakietów dla budowy PoC (.NET 10 / WPF) w środowisku LM: proxy eFOSS (Nexus)
  zamiast nuget.org. Plik jest wersjonowany i NIE zawiera poświadczeń.

  Poświadczenia (NTID + token dostępu eFOSS) trzymamy POZA repozytorium:
    - token generujesz w https://efoss.global.lmco.com/accesstoken (wymaga charge number + CAM),
    - Visual Studio zapisze je w Windows Credential Manager (zaznacz „zapamiętaj”),
    - budowa z wiersza poleceń: zmienna środowiskowa
        NuGetPackageSourceCredentials_eFOSS=Username=<NTID>;Password=<token>
      (ustaw w sesji, nie w pliku w repo),
    - albo użytkownikowy NuGet.config (poza repo) z sekcją <packageSourceCredentials>.
  NIGDY nie wpisuj tokenu do tego pliku ani nie commituj go do repozytorium.

  Proxy jest zależne od stanowiska i sieci – ustaw je w konfiguracji użytkownika / zmiennej
  środowiskowej HTTP_PROXY, jeśli jest wymagane (np. http://proxy-lmi.global.lmco.com:80).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="eFOSS" value="https://nexus.global.lmco.com/repository/nuget-proxy-v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
</configuration>
