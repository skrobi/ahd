<Application x:Class="PzlEv.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Wspólne widoki: szablon wyglądu (Templates) i fragmenty wielokrotnego użytku (Partials). -->
                <ResourceDictionary Source="Shared/Views/Templates/Theme.xaml" />
                <ResourceDictionary Source="Shared/Views/Partials/Partials.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
