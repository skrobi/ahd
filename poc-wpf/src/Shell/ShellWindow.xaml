<Window x:Class="PzlEv.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PZL-EV (test stosu)" Width="1360" Height="880" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" FontFamily="{StaticResource FBody}" FontSize="13"
        Foreground="{StaticResource Ink}">

    <!-- Powłoka: pasek środowiska, menu modułów i miejsce na ekran wybranego modułu. Bez treści modułów. -->
    <DockPanel>
        <!-- Pasek środowiska -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PZL-EV" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Pipeline EV · PZL Mielec · test stosu .NET (bez bazy)" Margin="10,0,0,0"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Padding="0,0,0,2" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding WindowsUser}" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Konto Windows (AD) bieżącego użytkownika" />
                <Border DockPanel.Dock="Right" Background="{StaticResource WarnSoft}" CornerRadius="4" Padding="8,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Environment}" FontFamily="{StaticResource FMono}" FontSize="12"
                               Foreground="{StaticResource Warn}" FontWeight="Medium" />
                </Border>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menu modułów (z IModule.NavLabel / NavBadge) -->
            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,1,0" Padding="10,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8">
                        <TextBlock Text="{Binding Footer}" FontSize="11" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="Bez połączenia z bazą (test)" FontSize="11" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Nav}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavBtn}" HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.Navigate, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}">
                                    <DockPanel Width="166">
                                        <Border DockPanel.Dock="Right">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource CountBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource FMono}" FontSize="11"
                                                       Foreground="{StaticResource Muted}" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Ekran wybranego modułu (IModule.CreateView) w układzie strony z Templates/Theme.xaml -->
            <ScrollViewer Grid.Column="1" Style="{StaticResource PageHost}">
                <ContentControl Content="{Binding CurrentView}" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
