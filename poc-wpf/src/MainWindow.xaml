<Window x:Class="PzlEv.Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mvvm="clr-namespace:PzlEv.Test.Mvvm"
        Title="PZL-EV (test stosu)" Width="1360" Height="880" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" FontFamily="{StaticResource FBody}" FontSize="13"
        Foreground="{StaticResource Ink}">

    <Window.Resources>
        <mvvm:LevelBrushConverter x:Key="LevelBrush" />

        <!-- Pigułka statusu -->
        <DataTemplate x:Key="PillTemplate">
            <Border Background="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=bg}"
                    CornerRadius="10" Padding="8,1" Margin="0,0,6,4" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="Medium"
                           Foreground="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" />
            </Border>
        </DataTemplate>

        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Pasek środowiska -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PZL-EV" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Pipeline EV · PZL Mielec · test stosu .NET (bez bazy)" Margin="10,0,0,0"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Padding="0,0,0,2" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding WindowsUser}" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Konto Windows (AD) bieżącego użytkownika" />
                <Border DockPanel.Dock="Right" Background="{StaticResource WarnSoft}" CornerRadius="4" Padding="8,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Environment}" FontFamily="{StaticResource FMono}" FontSize="12"
                               Foreground="{StaticResource Warn}" FontWeight="Medium" />
                </Border>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Nawigacja -->
            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,1,0" Padding="10,16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8">
                        <TextBlock Text="{Binding Footer}" FontSize="11" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="Bez połączenia z bazą (test)" FontSize="11" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Nav}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavBtn}" HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.Navigate, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}">
                                    <DockPanel Width="166">
                                        <Border DockPanel.Dock="Right" Background="{StaticResource Surface2}" CornerRadius="10"
                                                Padding="7,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource FMono}" FontSize="11"
                                                       Foreground="{StaticResource Muted}" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- Widok zastępczy dla ekranów poza zakresem testu -->
            <StackPanel Grid.Column="1" Margin="32,24">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPulpit}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding PlaceholderTitle}" Style="{StaticResource H1}" />
                <TextBlock Text="Ekran poza zakresem aplikacji testowej – test obejmuje wyłącznie Pulpit."
                           Style="{StaticResource MutedText}" Margin="0,8,0,16" />
                <Button Content="Wróć do Pulpitu" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left"
                        Command="{Binding Navigate}" CommandParameter="pulpit" />
            </StackPanel>

            <!-- PULPIT -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPulpit}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel Margin="32,24,32,48">
                    <!-- Nagłówek -->
                    <DockPanel Margin="0,0,0,20">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Import RABIT" Style="{StaticResource Btn}" Margin="0,0,8,0"
                                    Command="{Binding Navigate}" CommandParameter="import" />
                            <Button Content="Nowy projekt" Style="{StaticResource BtnPrimary}"
                                    Command="{Binding Navigate}" CommandParameter="projekty" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Eyebrow}" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="Pulpit" Style="{StaticResource H1}" Margin="0,2,0,4" />
                            <TextBlock Text="Fazy globalne (import RABIT, mapowanie CES↔P1S) i stan przebiegów wszystkich projektów."
                                       Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Karty faz globalnych -->
                    <ItemsControl ItemsSource="{Binding GlobalCards}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Tag}">
                                                <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="{StaticResource Muted}" />
                                            </Border>
                                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold" FontSize="15" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="12"
                                                   Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Pills}" ItemTemplate="{StaticResource PillTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Karty projektów -->
                    <ItemsControl ItemsSource="{Binding ZakresCards}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel}" Margin="0,0,12,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Tag}">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="{StaticResource Muted}" />
                                            </Border>
                                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold" FontSize="15" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                                        <ContentControl Content="{Binding ScopeWarning}" ContentTemplate="{StaticResource PillTemplate}" />
                                        <DockPanel Margin="0,4,0,6">
                                            <ContentControl DockPanel.Dock="Right" Content="{Binding RunStatus}"
                                                            ContentTemplate="{StaticResource PillTemplate}" />
                                            <TextBlock Text="{Binding RunId}" Style="{StaticResource MonoText}" FontSize="12" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Dots}" Margin="0,0,0,6">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="11" Height="11" Margin="0,0,5,0"
                                                             Fill="{Binding Level, Converter={StaticResource LevelBrush}, ConverterParameter=fg}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding RunLine}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LastBy}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Wymaga uwagi + Ostatnie zdarzenia -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,12,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Border DockPanel.Dock="Right" Background="{StaticResource Surface2}" CornerRadius="10" Padding="7,0">
                                        <TextBlock Text="{Binding AttentionCount}" FontFamily="{StaticResource FMono}"
                                                   Foreground="{StaticResource Muted}" />
                                    </Border>
                                    <TextBlock Text="Wymaga uwagi" Style="{StaticResource H2}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Attention}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <DockPanel>
                                                    <ContentControl DockPanel.Dock="Left" Width="96" VerticalAlignment="Top"
                                                                    Content="{Binding Tag}" ContentTemplate="{StaticResource PillTemplate}" />
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Ostatnie zdarzenia" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Events}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock FontSize="11" Foreground="{StaticResource Muted}" FontFamily="{StaticResource FMono}">
                                                    <Run Text="{Binding When, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Where, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Who, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Diagnostyka środowiska – wynik testu stosu -->
                    <Border Style="{StaticResource Panel}" BorderBrush="{StaticResource Accent}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag}">
                                    <TextBlock Text="test stosu" FontSize="11" Foreground="{StaticResource Muted}" />
                                </Border>
                                <TextBlock Text="Diagnostyka środowiska" Style="{StaticResource H2}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8"
                                       Text="Jeśli widzisz ten panel z wersjami pakietów, .exe uruchomił się bez instalacji .NET, a pakiety z założeń wczytały się z jednego pliku." />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Runtime" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Runtime}" Style="{StaticResource MonoText}" />
                                <TextBlock Grid.Row="1" Text="System" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Os}" Style="{StaticResource MonoText}" />
                                <TextBlock Grid.Row="2" Text="Uruchomiono z" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExePath}" Style="{StaticResource MonoText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="Konto Windows" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WindowsUser}" Style="{StaticResource MonoText}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Packages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                            <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource MonoText}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Location}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
