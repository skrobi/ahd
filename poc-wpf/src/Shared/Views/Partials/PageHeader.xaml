<UserControl x:Class="PzlEv.Shared.Views.Partials.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PzlEv.Shared.Views.Partials">
    <!-- Nagłówek ekranu modułu: linia kontekstu, tytuł, opis i przyciski akcji po prawej. -->
    <DockPanel Margin="0,0,0,20">
        <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Top"
                          Content="{Binding Actions, RelativeSource={RelativeSource AncestorType=local:PageHeader}}" />
        <StackPanel>
            <TextBlock Text="{Binding Eyebrow, RelativeSource={RelativeSource AncestorType=local:PageHeader}}"
                       Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:PageHeader}}"
                       Style="{StaticResource H1}" Margin="0,2,0,4" />
            <TextBlock Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=local:PageHeader}}"
                       Style="{StaticResource MutedText}" />
        </StackPanel>
    </DockPanel>
</UserControl>
